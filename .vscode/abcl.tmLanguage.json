{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ABCL/c+",
  "scopeName": "source.abcl",
  "patterns": [
    { "include": "#comment" },
    { "include": "#keyword" },
    { "include": "#type" },
    { "include": "#self-sender" },
    { "include": "#string" },
    { "include": "#number" },
    { "include": "#operator" },
    { "include": "#function-call" },
    { "include": "#identifier" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.abcl"
    },
    "keyword": {
      "match": "\\b(class|method|var|new|send|call|become|now|future|if|else|while|do|return)\\b",
      "name": "keyword.control.abcl"
    },
    "type": {
      "match": "\\b(int|float|string|bool|any)\\b",
      "name": "storage.type.abcl"
    },
    "self-sender": {
      "match": "\\b(self|sender|true|false)\\b",
      "name": "variable.language.abcl"
    },
    "string": {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.abcl",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.abcl" }
      ]
    },
    "number": {
      "match": "\\b([0-9]+\\.[0-9]*|\\.[0-9]+|[0-9]+)\\b",
      "name": "constant.numeric.abcl"
    },
    "operator": {
      "match": "(==|!=|<=|>=|<|>|\\+|-|\\*|/|=)",
      "name": "keyword.operator.abcl"
    },
    "function-call": {
      "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*(?=\\()",
      "name": "entity.name.function.abcl"
    },
    "identifier": {
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b",
      "name": "variable.other.abcl"
    }
  }
}
