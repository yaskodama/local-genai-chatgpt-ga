// LocalGenAIEvolutionJP — v2 (.ga.json IR を生成するための入力).
//
// aice-z-evolution/examples/LocalGenAIEvolutionJP.aice (v1, stages/mutations
// による直線進化) を、 v2 の MAP-Elites パラダイムへ翻訳した版.
//
// v1 の 7 stages は、 v2 では (model_family x training_paradigm x param_class)
// の 3 軸セルとして並列に扱う. 突然変異 M1..M10 は v2 の operator semantics
// (single_axis / multi_axis_correlated / llm_directed) に丸める.
// 候補の濃い prompt は v1 側 .aice に残す (v2 は spec を gene_schema に集約).
//
// 共通評価プロトコル:
//   corpus  = TinyShakespeare-first-100KB (SHA-256 ロック)
//   split   = 95% train / 5% holdout
//   metric  = byte-level perplexity on holdout
//   seed    = 42
//   deps    = python>=3.11, pytorch==2.x, numpy
//   compute = M2 MacBook (MPS), 30 min/candidate 上限
//   API     = 外部不可

aice LocalGenAIEvolutionJP {
  dialect = "aice_evolution_v2";

  task = "ローカル MacBook (M2, MPS, 16GB RAM) のみで動く byte 単位の生成 AI を、 設計推定式 (params, FLOPs, memory, expected_ppl) を根拠に MAP-Elites で並列探索する. cell は (model_family, training_paradigm, param_class) の 3 軸で切り、 各セル champion を 3 レビュアー (言語品質 / 効率 / 再現性) で採点する. 共通評価プロトコルは [TinyShakespeare-100KB, 95-5 split, byte-ppl, seed=42, no_external_api, <=30min/candidate]. 終端目標は (self_evolving_compact, self_proposed_mutation, 3M) セルが 3 レビュアー累積点で Pareto front を支配し、 半自動の進化ループが成立すること.";

  gene_schema = "schemas/local_genai.schema.json";

  evaluation_tasks {
    task ByteShakespearePPL {
      spec = "TinyShakespeare-100KB の holdout 5% で byte-level perplexity を測る. 学習は 30 分以内. seed=42 固定. 期待 ppl レンジは param_class に依存 (32K: 8-10, 100K: 6-7, 1M: 5-5.5, 3M: 4-4.5, 10M: 3.8-4.2).";
    }
    task TrainTimeUnder30min {
      spec = "M2 MPS で 30 分以内に train loop が終わる. 超過は失格.";
    }
    task ParamBudgetWithinClass {
      spec = "param_class 軸の上限 (32K=64KB-table, 100K=200K, 1M=1.5M, 3M=4M, 10M=12M params) を超えない.";
    }
    task ReproducibilityChecklist {
      spec = "seed 固定 / corpus SHA-256 ロック / 外部 API 不使用 / 依存 python+pytorch+numpy のみ / 単一スクリプトで train+eval が走る. 5 項目 0-2 点で計 0-10 点.";
    }
    task SelfEvolutionDryRun {
      spec = "self_evolution!=none のとき、 過去 .aice 履歴と reviewer 累積点を入力に、 次の 3 mutation 候補を mutation ブロック形式で出力する. 既存 mutation との名前重複ゼロ、 expected_delta が 1 行入っていることを確認.";
    }
  }

  search {
    algorithm   = "map_elites";
    cell_axes   = "model_family, training_paradigm, param_class";
    generations = 30;
    seed_count  = 8;
    open_axes   = true;
    rng_seed    = 42;
  }

  meta_fitness {
    trend_alignment       = 0.20;
    frontier_coverage     = 0.20;
    novelty               = 0.10;
    evolvability          = 0.20;
    cross_task_generality = 0.15;
    implementability      = 0.15;
  }

  ranking {
    strategy  = "pareto_then_pairwise";
    scenarios = ["conservative", "innovative", "general_purpose"];
    top_k     = 3;
  }

  reviewers {
    reviewer Quality {
      persona = "あなたは言語品質レビュアーです. 候補ジェノムから expected_holdout_ppl を推定し (32K: 8-10, 100K: 6-7, 1M: 5-5.5, 3M: 4-4.5, 10M: 3.8-4.2), ジェノム内の他軸 (positional, normalization, regularization) との整合性を確認します. 採点は 4 軸 [holdout_ppl 期待値 / 学習 loss 推移の合理性 / 退化モード耐性 / 世代相応サイズ] でそれぞれ 0-3 点、 計 0-12 点. 最後に最良候補番号を 1 行で返します.";
    }
    reviewer Efficiency {
      persona = "あなたは効率レビュアーです. 候補ジェノムから (params, flops_per_token, activation_mem, train_time_estimate) を共通設計推定式で再計算し、 param_class 軸上限を超えていないか、 inference_optimization の効果が量に見合うかを確認します. 採点は 4 軸 [ppl_per_param / param 上限内 / train_time<=30min / inference 改善] それぞれ 0-3 点、 計 0-12 点. 最後に最良候補番号を 1 行で返します.";
    }
    reviewer Reproducibility {
      persona = "あなたは再現性レビュアーです. 採点は 5 軸 [seed 固定 / corpus SHA-256 ロック / 外部 API 不使用 / 依存最小 / 単一スクリプト] それぞれ 0-2 点、 計 0-10 点. self_evolution!=none の候補は SelfEvolutionDryRun タスクの結果も加点要素にします. 最後に最良候補番号を 1 行で返します.";
    }
  }
}
