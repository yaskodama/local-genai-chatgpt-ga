        "kind": "single_axis",
        "axis": "train_data_scale",
        "weight": 0.2
      },
      {
        "name": "context_capacity_pair",
        "kind": "multi_axis_correlated",
        "axes": [
          "context_class",
          "model_scale"
        ],
        "weight": 0.16
      },
      {
        "name": "delivery_bridge",
        "kind": "single_axis",
        "axis": "delivery_mode",
        "weight": 0.12
      },
      {
        "name": "aipl_feedback_update",
        "kind": "llm_directed",
        "axis": "aipl_feedback",
        "weight": 0.12
      }
    ],
    "crossovers": [
      {
        "name": "vocab_plus_data",
        "kind": "axis_merge",
        "axes": [
          "vocab_class",
          "train_data_scale"
        ],
        "weight": 0.35
      },
      {
        "name": "ja_plus_tokenizer",
        "kind": "axis_merge",
        "axes": [
          "japanese_support",
          "tokenizer_family"
        ],
        "weight": 0.3
      },
      {
        "name": "productized_champion",
        "kind": "axis_merge",
        "axes": [
          "model_scale",
          "delivery_mode"
        ],
        "weight": 0.2
      },
      {
        "name": "llm_merge",
        "kind": "llm_directed",
        "weight": 0.15
      }
    ]
  },
  "evaluation": {
    "tasks": [
      {
        "name": "BitsPerByte",
        "spec": "10MB holdout の raw bytes 上で bpb を測る。異なる tokenizer を比較する唯一の primary metric。現 champion bpb=1.911 を下回ることを成功とする。"
      },
      {
        "name": "JapaneseSupport",
        "spec": "日本語 prompt を UTF-8 byte/BPE として破綻なく encode/decode できること。日本語 corpus を混ぜる場合は english_bpb と japanese_bpb を分けて記録する。"
      },
      {
        "name": "TrainDataScale",
        "spec": "10MB baseline から 30MB/100MB/mixed_en_ja へ拡張する候補は、データ SHA-256、source、dedupe 方針、train_time 見積もりを必須にする。"
      },
      {
        "name": "ChatUsability",
        "spec": "checkpoint と tokenizer を chat.py から読み、prompt continuation を対話的に確認できること。"
      },
      {
        "name": "Reproducibility",
        "spec": "seed 固定、corpus SHA-256 lock、依存は torch/numpy/tokenizers に限定、外部 API 不使用、単一コマンドで train+eval+checkpoint+metrics JSON を生成する。"
      }
    ],
    "reviewers": [
      {
        "name": "BPBQuality",
        "persona": "bpb 改善、tokenizer 健全性、学習曲線、OOD/1MB tail リスクを 12 点満点で評価する。"
      },
      {
        "name": "Efficiency",
        "persona": "M2 MPS 訓練時間、params、token 圧縮、推論効率を 12 点満点で評価する。"
      },
      {
        "name": "Productization",
        "persona": "chat.py 接続、サンプル比較、CLI 一貫性、ドキュメントを 12 点満点で評価する。"
      },
      {
        "name": "AIPLFeedback",
        "persona": "prior 化、失敗知識の明示、MAP-Elites 軸、次候補生成しやすさを 12 点満点で評価する。"
      }
    ]
  },
  "search": {
    "algorithm": "map_elites",
    "cell_axes": [
      "tokenizer_family",
      "vocab_class",
      "context_class",
      "model_scale",
      "japanese_support",
      "train_data_scale",
      "delivery_mode",
      "aipl_feedback"
    ],
    "generations": 40,
    "seed_count": 12,
    "open_axes": true,
    "rng_seed": 9112048
  },
  "meta_fitness": {
    "bpb_improvement": 0.3,
    "japanese_support": 0.15,
