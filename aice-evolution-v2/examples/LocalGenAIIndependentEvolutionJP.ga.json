  "operators": {
    "mutations": [
      {
        "name": "vocab_expand",
        "kind": "single_axis",
        "axis": "vocab_class",
        "weight": 0.22
      },
      {
        "name": "japanese_support_lift",
        "kind": "single_axis",
        "axis": "japanese_support",
        "weight": 0.18
