// Generated from LocalGenAIIndependentEvolutionJP.ga.json
//
// Run from an aios-claude checkout:
//   cd aice-evolution-v2/examples
//   mkdir -p out
//   AIPL_AI_PROVIDER=mock /usr/bin/python3 ../../src/python-aipl/aipl_main.py LocalGenAIIndependentEvolutionJP.abcl
//
// This ABCL orchestrator keeps the .ga.json genes explicit:
// - japanese_support
// - train_data_scale
// and evolves local-genai candidates with MAP-Elites style cell champions.

class Util {
  method count_csv(csv) {
    if (str_len(csv) == 0) { reply(0); }
    else {
      var n = 1;
      var s = csv;
      var done = 0;
      while (done == 0) do {
        var c = str_index(s, ",");
        if (c < 0) { done = 1; }
        else {
          n = n + 1;
          s = str_sub(s, c + 1);
        }
      }
      reply(n);
    }
  }

  method nth_csv(csv, n) {
    var i = 0;
    var s = csv;
    while (i < n) do {
      var c = str_index(s, ",");
      if (c < 0) {
        s = "";
        i = n;
      } else {
        s = str_sub(s, c + 1);
        i = i + 1;
      }
    }
    var c2 = str_index(s, ",");
    if (c2 < 0) { reply(s); }
    else { reply(str_sub(s, 0, c2)); }
  }

  method axis_values(table, axis) {
    var key = axis + ":";
    var idx = str_index(table, key);
    if (idx < 0) { reply(""); }
    else {
      var start = idx + str_len(key);
      var rest = str_sub(table, start);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(rest); }
      else { reply(str_sub(rest, 0, bar)); }
    }
  }

  method get_axis(genome, axis) {
    var key = axis + "=";
    var idx = str_index(genome, key);
    if (idx < 0) { reply(""); }
    else {
      var start = idx + str_len(key);
      var rest = str_sub(genome, start);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(rest); }
      else { reply(str_sub(rest, 0, bar)); }
    }
  }

  method set_axis(genome, axis, value) {
    var key = axis + "=";
    var idx = str_index(genome, key);
    if (idx < 0) {
      if (str_len(genome) == 0) { reply(key + value); }
      else { reply(genome + "|" + key + value); }
    } else {
      var prefix = str_sub(genome, 0, idx);
      var after = idx + str_len(key);
      var rest = str_sub(genome, after);
      var bar = str_index(rest, "|");
      if (bar < 0) { reply(prefix + key + value); }
      else {
        var suffix = str_sub(rest, bar);
        reply(prefix + key + value + suffix);
      }
    }
  }
}

class Generator {
  var util = 0;
  var axes_csv = "";
  var values_table = "";

  method init(u, axes, values) {
    util = u;
    axes_csv = axes;
    values_table = values;
  }

  method seed_random() {
    var n_axes = now util.count_csv(axes_csv);
    var i = 0;
    var g = "";
    while (i < n_axes) do {
      var axis = now util.nth_csv(axes_csv, i);
      var vals = now util.axis_values(values_table, axis);
      var n_vals = now util.count_csv(vals);
      var v = now util.nth_csv(vals, random(n_vals));
      if (i == 0) { g = axis + "=" + v; }
      else { g = g + "|" + axis + "=" + v; }
      i = i + 1;
    }
    reply(g);
  }

  method seed_known(i) {
    if (i == 0) {
      reply("tokenizer_family=bytelevel_bpe|vocab_class=1024|context_class=ctx256_current|model_scale=stage9_bpe_extend|japanese_support=utf8_decode_smoke|train_data_scale=10MB_en_baseline|delivery_mode=chat_py|aipl_feedback=productization");
    } else if (i == 1) {
      reply("tokenizer_family=bytelevel_bpe|vocab_class=2048|context_class=ctx256_effective_3to4_bytes_per_token|model_scale=depth6_d128_1p4M|japanese_support=utf8_tokenizer_only|train_data_scale=10MB_en_baseline|delivery_mode=train_eval_checkpoint|aipl_feedback=vocab_axis");
    } else if (i == 2) {
      reply("tokenizer_family=bytelevel_bpe|vocab_class=1536|context_class=ctx256_effective_midpoint|model_scale=depth6_d128_1p35M|japanese_support=utf8_tokenizer_only|train_data_scale=10MB_en_baseline|delivery_mode=train_eval_checkpoint|aipl_feedback=midpoint_guard");
    } else if (i == 3) {
      reply("tokenizer_family=bytelevel_bpe|vocab_class=2048|context_class=ctx256_mixed_utf8|model_scale=depth6_d128_1p4M|japanese_support=ja_mixed_corpus|train_data_scale=30MB_mixed_en_ja|delivery_mode=train_eval_checkpoint|aipl_feedback=multilingual_axis");
    } else if (i == 4) {
      reply("tokenizer_family=bytelevel_bpe|vocab_class=4096|context_class=ctx384_or_ctx512|model_scale=depth6_d160_2M_guarded|japanese_support=optional_ja_eval|train_data_scale=100MB_deduped|delivery_mode=train_eval_checkpoint|aipl_feedback=data_scale_axis");
    } else {
      var n_axes = now util.count_csv(axes_csv);
      var ai = 0;
      var g = "";
      while (ai < n_axes) do {
        var axis = now util.nth_csv(axes_csv, ai);
        var vals = now util.axis_values(values_table, axis);
        var n_vals = now util.count_csv(vals);
        var v = now util.nth_csv(vals, random(n_vals));
        if (ai == 0) { g = axis + "=" + v; }
        else { g = g + "|" + axis + "=" + v; }
        ai = ai + 1;
      }
      reply(g);
    }
  }

  method mutate(parent) {
    var n_axes = now util.count_csv(axes_csv);
    var idx = random(n_axes);
    var axis = now util.nth_csv(axes_csv, idx);
    var vals = now util.axis_values(values_table, axis);
    var n_vals = now util.count_csv(vals);
    var v = now util.nth_csv(vals, random(n_vals));
    var child = now util.set_axis(parent, axis, v);
    reply(child);
  }

  method cross(a, b) {
    var n_axes = now util.count_csv(axes_csv);
    var i = 0;
    var child = "";
    while (i < n_axes) do {
      var axis = now util.nth_csv(axes_csv, i);
      var src = a;
      if (random(2) == 1) { src = b; }
      var v = now util.get_axis(src, axis);
      if (i == 0) { child = axis + "=" + v; }
      else { child = child + "|" + axis + "=" + v; }
      i = i + 1;
    }
    reply(child);
  }
}

class Evaluator {
  var util = 0;

  method init(u) {
    util = u;
  }

  method has(genome, axis, value) {
    var got = now util.get_axis(genome, axis);
    if (got == value) { reply(1); }
    else { reply(0); }
  }

  method score(genome) {
    // Deterministic proxy for the .ga reviewers:
    // bpb improvement, Japanese support, data scale, reproducibility,
    // train-time efficiency, generation usability, and AIPL feedback.
    var s = 0.0;

    var vocab = now util.get_axis(genome, "vocab_class");
    var ja = now util.get_axis(genome, "japanese_support");
    var data = now util.get_axis(genome, "train_data_scale");
    var scale = now util.get_axis(genome, "model_scale");
    var delivery = now util.get_axis(genome, "delivery_mode");
    var feedback = now util.get_axis(genome, "aipl_feedback");

    if (vocab == "2048") { s = s + 0.18; }
    if (vocab == "1536") { s = s + 0.12; }
    if (vocab == "4096") { s = s + 0.14; }

    if (ja == "utf8_tokenizer_only") { s = s + 0.10; }
    if (ja == "ja_mixed_corpus") { s = s + 0.15; }
    if (ja == "optional_ja_eval") { s = s + 0.08; }

    if (data == "10MB_en_baseline") { s = s + 0.10; }
    if (data == "30MB_mixed_en_ja") { s = s + 0.15; }
    if (data == "100MB_deduped") { s = s + 0.13; }

    if (scale == "depth6_d128_1p4M") { s = s + 0.12; }
    if (scale == "depth6_d160_2M_guarded") { s = s + 0.06; }
    if (scale == "stage9_bpe_extend") { s = s + 0.08; }

    if (delivery == "chat_py") { s = s + 0.10; }
    if (delivery == "train_eval_checkpoint") { s = s + 0.09; }

    if (feedback == "vocab_axis") { s = s + 0.08; }
    if (feedback == "multilingual_axis") { s = s + 0.08; }
    if (feedback == "data_scale_axis") { s = s + 0.06; }
    if (feedback == "productization") { s = s + 0.06; }

    // Coherence penalties from the .ga schema.
    if (vocab == "4096") {
      if (data != "100MB_deduped") { s = s - 0.20; }
    }
    if (ja == "ja_mixed_corpus") {
      if (data != "30MB_mixed_en_ja") {
        if (data != "100MB_deduped") { s = s - 0.20; }
      }
    }
    if (delivery == "chat_py") {
      if (data != "10MB_en_baseline") { s = s - 0.15; }
    }

    if (s < 0.0) { s = 0.0; }
    if (s > 1.0) { s = 1.0; }
    reply(s);
  }
}

class EliteMap {
  var cells = [];
  var ids = [];
  var scores = [];
  var genomes = [];

  method propose(cell, ind_id, genome, score) {
    var n = array_len(cells);
    var i = 0;
    var idx = -1;
    while (i < n) do {
      if (array_get(cells, i) == cell) {
        idx = i;
        i = n;
      } else {
        i = i + 1;
      }
    }
    if (idx < 0) {
      array_push(cells, cell);
      array_push(ids, ind_id);
      array_push(scores, score);
      array_push(genomes, genome);
      reply(1);
    } else {
      var existing = array_get(scores, idx);
      if (score > existing) {
        array_set(ids, idx, ind_id);
        array_set(scores, idx, score);
        array_set(genomes, idx, genome);
        reply(1);
      } else {
        reply(0);
      }
    }
  }

  method size() { reply(array_len(cells)); }

  method sample_random_genome() {
    var n = array_len(cells);
    if (n == 0) { reply(""); }
    else { reply(array_get(genomes, random(n))); }
  }

  method best_summary(top_k) {
    var n = array_len(cells);
    var i = 0;
    var out = "";
    while (i < n) do {
      var line = "cell=" + array_get(cells, i) +
                 " score=" + array_get(scores, i) +
                 " id=" + array_get(ids, i) +
                 " genome=" + array_get(genomes, i);
      if (i == 0) { out = line; }
      else { out = out + "\n" + line; }
      i = i + 1;
    }
    reply(out);
  }
}

class Lineage {
  var ids = [];
  var genomes = [];
  var parents = [];
  var scores = [];
  var generations = [];
  var operators = [];
  var cells = [];

  method add(id, genome, parent, score, gen, op, cell) {
    array_push(ids, id);
    array_push(genomes, genome);
    array_push(parents, parent);
    array_push(scores, score);
    array_push(generations, gen);
    array_push(operators, op);
    array_push(cells, cell);
    reply(array_len(ids));
  }

  method dump(path) {
    var n = array_len(ids);
    var i = 0;
    var out = "[\n";
    while (i < n) do {
      var entry = "  {\"id\":\"" + array_get(ids, i) + "\"," +
                  "\"genome\":\"" + array_get(genomes, i) + "\"," +
                  "\"parent\":\"" + array_get(parents, i) + "\"," +
                  "\"score\":" + array_get(scores, i) + "0," +
                  "\"generation\":" + array_get(generations, i) + "," +
                  "\"operator\":\"" + array_get(operators, i) + "\"," +
                  "\"cell\":\"" + array_get(cells, i) + "\"}";
      if (i < n - 1) { out = out + entry + ",\n"; }
      else { out = out + entry + "\n"; }
      i = i + 1;
    }
    out = out + "]\n";
    write_file(path, out);
    reply(n);
  }
}

class Coordinator {
  var util = 0;
  var generator = 0;
  var evaluator = 0;
  var elite = 0;
  var lineage = 0;

  var seed_count = 12;
  var generations = 40;
  var cell_axes_csv = "tokenizer_family,vocab_class,context_class,model_scale,japanese_support,train_data_scale,delivery_mode,aipl_feedback";
  var next_id = 0;

  method init(u, g, e, em, lg) {
    util = u;
    generator = g;
    evaluator = e;
    elite = em;
    lineage = lg;
  }

  method run() {
    print("=== LocalGenAIIndependentEvolutionJP ABCL orchestrator ===");
    print("genes include japanese_support and train_data_scale");
    print("seed_count=" + seed_count + " generations=" + generations);

    var i = 0;
    while (i < seed_count) do {
      var g = now generator.seed_known(i);
      next_id = next_id + 1;
      var id = "I" + next_id;
      var cell = "";
      var n = now util.count_csv(cell_axes_csv);
      var ci = 0;
      while (ci < n) do {
        var axis = now util.nth_csv(cell_axes_csv, ci);
        var v = now util.get_axis(g, axis);
        if (ci == 0) { cell = axis + "=" + v; }
        else { cell = cell + "|" + axis + "=" + v; }
        ci = ci + 1;
      }
      var score = now evaluator.score(g);
      send lineage.add(id, g, "", score, 0, "seed", cell);
      send elite.propose(cell, id, g, score);
      i = i + 1;
    }
    print("[seed] elite cells filled: " + (now elite.size()));

    var gen = 1;
    while (gen <= generations) do {
      var parent = now elite.sample_random_genome();
      var child = "";
      var op = "";
      if (random(10) < 3) {
        var partner = now elite.sample_random_genome();
        child = now generator.cross(parent, partner);
        op = "uniform_crossover";
      } else {
        child = now generator.mutate(parent);
        op = "axis_resample";
      }
      next_id = next_id + 1;
      var cid = "I" + next_id;
      var ccell = "";
      var cn = now util.count_csv(cell_axes_csv);
      var cci = 0;
      while (cci < cn) do {
        var caxis = now util.nth_csv(cell_axes_csv, cci);
        var cv = now util.get_axis(child, caxis);
        if (cci == 0) { ccell = caxis + "=" + cv; }
        else { ccell = ccell + "|" + caxis + "=" + cv; }
        cci = cci + 1;
      }
      var cscore = now evaluator.score(child);
      send lineage.add(cid, child, parent, cscore, gen, op, ccell);
      send elite.propose(ccell, cid, child, cscore);
      gen = gen + 1;
    }

    print("[done] cells filled: " + (now elite.size()));
    print(now elite.best_summary(5));

    var n = now lineage.dump("out/LocalGenAIIndependentEvolutionJP.abcl_lineage.json");
    print("[lineage] wrote " + n + " individuals to out/LocalGenAIIndependentEvolutionJP.abcl_lineage.json");
  }
}

var util = new Util();
var generator = new Generator(
  util,
  "tokenizer_family,vocab_class,context_class,model_scale,japanese_support,train_data_scale,delivery_mode,aipl_feedback",
  "tokenizer_family:byte,bytelevel_bpe,unigram,hybrid_byte_bpe|vocab_class:256,1024,1536,2048,4096|context_class:ctx256_current,ctx256_effective_midpoint,ctx256_effective_3to4_bytes_per_token,ctx256_mixed_utf8,ctx384_or_ctx512|model_scale:stage9_bpe_extend,depth6_d128_1p35M,depth6_d128_1p4M,depth6_d160_2M_guarded|japanese_support:none,utf8_decode_smoke,utf8_tokenizer_only,ja_mixed_corpus,optional_ja_eval|train_data_scale:10MB_en_baseline,30MB_en,30MB_mixed_en_ja,100MB_deduped|delivery_mode:train_eval_checkpoint,chat_py,generate_samples,aipl_prior_update|aipl_feedback:none,vocab_axis,midpoint_guard,productization,multilingual_axis,data_scale_axis"
);
var evaluator = new Evaluator(util);
var elite = new EliteMap();
var lineage = new Lineage();
var coord = new Coordinator(util, generator, evaluator, elite, lineage);
send coord.run();
