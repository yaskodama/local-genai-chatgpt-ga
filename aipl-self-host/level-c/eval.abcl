// Level C — AIPL evaluator.
//
// Simplified port of Level A's metacircular evaluator that can run
// the AST records produced by parser.abcl (a single Block flattened
// into the program's main list, If/While bodies stored as stmt arrays).
//
// We use the same env / function-table idioms as Level A:
//   env:  array of (name, value) tuples; tail-first lookup wins.

function meta_env_get(env, name) {
  var i: int = array_len(env) - 1;
  while (i >= 0) do {
    var pair = array_get(env, i);
    if (pair[0] == name) { return pair[1]; }
    i = i - 1;
  }
  return 0;
}

function meta_env_set(env, name, value) {
  array_push(env, (name, value));
  return value;
}

function apply_binop(op: string, a, b) {
  if (op == "+")  { return a + b; }
  if (op == "-")  { return a - b; }
  if (op == "*")  { return a * b; }
  if (op == "/")  { return a / b; }
  if (op == "==") { if (a == b) { return 1; } return 0; }
  if (op == "!=") { if (a != b) { return 1; } return 0; }
  if (op == "<")  { if (a <  b) { return 1; } return 0; }
  if (op == ">")  { if (a >  b) { return 1; } return 0; }
  if (op == "<=") { if (a <= b) { return 1; } return 0; }
  if (op == ">=") { if (a >= b) { return 1; } return 0; }
  return 0;
}

function eval_expr(ast, env) {
  if (ast.tag == "Int") { return ast.val; }
  if (ast.tag == "Str") { return ast.val; }
  if (ast.tag == "Var") { return meta_env_get(env, ast.name); }
  if (ast.tag == "Binop") {
    var l = eval_expr(ast.lhs, env);
    var r = eval_expr(ast.rhs, env);
    return apply_binop(ast.op, l, r);
  }
  if (ast.tag == "Call") {
    // For Level C we only support intrinsic calls inline (none yet);
    // built-in printing is via the Print stmt, not Call.
    return 0;
  }
  return 0;
}

function eval_stmt(ast, env) {
  if (ast.tag == "VarDecl") {
    var v = eval_expr(ast.expr, env);
    meta_env_set(env, ast.name, v);
    return v;
  }
  if (ast.tag == "Assign") {
    var v = eval_expr(ast.expr, env);
    meta_env_set(env, ast.name, v);
    return v;
  }
  if (ast.tag == "Print") {
    var v = eval_expr(ast.expr, env);
    print(v);
    return 0;
  }
  if (ast.tag == "If") {
    var c = eval_expr(ast.cond, env);
    if (c != 0) { return eval_stmt_list(ast.then_body, env); }
    return eval_stmt_list(ast.else_body, env);
  }
  if (ast.tag == "While") {
    var c = eval_expr(ast.cond, env);
    while (c != 0) do {
      eval_stmt_list(ast.body, env);
      c = eval_expr(ast.cond, env);
    }
    return 0;
  }
  return 0;
}

function eval_stmt_list(stmts, env) {
  var i: int = 0;
  var n: int = array_len(stmts);
  while (i < n) do {
    eval_stmt(array_get(stmts, i), env);
    i = i + 1;
  }
  return 0;
}

function run_program(prog) {
  var env = [];
  return eval_stmt_list(prog.main, env);
}
