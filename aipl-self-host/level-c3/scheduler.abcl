// Level C-3 — Adds `now` (synchronous send) + `Reply` to the
// Level C-2 cooperative scheduler.  A method body can now contain:
//
//   var v = now target.method(args);   // blocks until target replies
//   reply(value);                       // inside target's method body
//
// The scheduler stays single-threaded: a `now` call drives the
// scheduler recursively until the target's reply slot is filled.
//
// Message shape extends to:
//   {meth, args, slot: int-or-zero}
//
// Slot 0 means "no reply expected".  Otherwise the scheduler keeps
// a slot table of (id, value, filled?) records keyed by id.
//
// Level C-2 — Actor Scheduler + Mailbox in AIPL.
//
// Provides a single-threaded cooperative scheduler that:
//   - holds a registry of actors (name -> actor record)
//   - each actor has a private mailbox (FIFO array of message records)
//   - scheduler_run() walks actors round-robin and pops one message
//     per actor per iteration, evaluating its method body
//
// Actor representation:
//   {name: "c1",
//    class_name: "Counter",
//    fields:  [(name, value), ...],   // mutable, tail-first lookup wins
//    methods: [(name, {params, body}), ...],
//    queue:   [{method, args}, ...]}
//
// Scheduler representation:
//   {actors: [(name, actor), ...]}
//
// AST shape (extended from Level C):
//   {tag:"Int",      val:N}
//   {tag:"Str",      val:S}
//   {tag:"Var",      name:X}              // looks up env first, then fields
//   {tag:"Binop",    op, lhs, rhs}
//   {tag:"VarDecl",  name, expr}
//   {tag:"Assign",   name, expr}          // updates env if local, fields otherwise
//   {tag:"Print",    expr}
//   {tag:"If",       cond, then_body, else_body}
//   {tag:"While",    cond, body}
//   {tag:"Return",   expr}
//   {tag:"Send",     target, method, args}    // NEW: enqueue on another actor
//   {tag:"Self",     method, args}            // NEW: send to self
//
// The host runtime contributes only `print` and `array_push/get/len`
// (and the outer driver that calls scheduler_run).

// =================================================================
// PART 1 — env helpers (carried over from Level A).
// =================================================================

function env_get_aipl(env, name) {
  var i: int = array_len(env) - 1;
  while (i >= 0) do {
    var pair = array_get(env, i);
    if (pair[0] == name) { return pair[1]; }
    i = i - 1;
  }
  return 0;
}

function env_set_aipl(env, name, value) {
  array_push(env, (name, value));
  return value;
}

// =================================================================
// PART 2 — actor / scheduler primitives.
// =================================================================

// Build a new actor record.  `fields_init` is an array of (name, value)
// tuples; `methods` is an array of (name, {params, body}) tuples.
function actor_new(name: string, class_name: string, fields_init, methods) {
  return {name: name,
          class_name: class_name,
          fields: fields_init,
          methods: methods,
          queue: []};
}

// Look up a method by name on an actor.  Returns 0 if not found.
function actor_method(actor, mname: string) {
  var i: int = 0;
  var n: int = array_len(actor.methods);
  while (i < n) do {
    var pair = array_get(actor.methods, i);
    if (pair[0] == mname) { return pair[1]; }
    i = i + 1;
  }
  return 0;
}

// Scheduler with reply-slot support (Phase 17 carry-over).
function sched_new() {
  return {actors: [], slots: [], next_slot: 1};
}

// Allocate a fresh reply slot, return its id.
function sched_alloc_slot(sched) {
  var id: int = sched.next_slot;
  sched.next_slot = id + 1;
  array_push(sched.slots, {id: id, value: 0, filled: 0});
  return id;
}

function sched_get_slot(sched, id: int) {
  var i: int = 0;
  var n: int = array_len(sched.slots);
  while (i < n) do {
    var s = array_get(sched.slots, i);
    if (s.id == id) { return s; }
    i = i + 1;
  }
  return 0;
}

function sched_fill_slot(sched, id: int, value) {
  var s = sched_get_slot(sched, id);
  if (s == 0) {
    print("[sched] fill_slot: unknown id " + id);
    return 0;
  }
  s.value = value;
  s.filled = 1;
  return 0;
}

function sched_register(sched, actor) {
  array_push(sched.actors, (actor.name, actor));
  return 0;
}

function sched_lookup(sched, name: string) {
  var i: int = array_len(sched.actors) - 1;
  while (i >= 0) do {
    var pair = array_get(sched.actors, i);
    if (pair[0] == name) { return pair[1]; }
    i = i - 1;
  }
  return 0;
}

// Push a message onto an actor's queue.  Caller resolved the target
// actor already; we mutate its queue in place.
function actor_enqueue(actor, msg) {
  array_push(actor.queue, msg);
  return 0;
}

// Pop the head of an actor's queue.  Returns 0 if empty.
// AIPL has no array_shift; we use a "consumed" index field on the
// queue's first entry.  Easier: rebuild queue.
function actor_dequeue(actor) {
  var n: int = array_len(actor.queue);
  if (n == 0) { return 0; }
  var head = array_get(actor.queue, 0);
  // rebuild without head
  var rest = [];
  var i: int = 1;
  while (i < n) do {
    array_push(rest, array_get(actor.queue, i));
    i = i + 1;
  }
  actor.queue = rest;
  return head;
}

// =================================================================
// PART 3 — actor-aware evaluator.
// =================================================================

function apply_binop(op: string, a, b) {
  if (op == "+")  { return a + b; }
  if (op == "-")  { return a - b; }
  if (op == "*")  { return a * b; }
  if (op == "/")  { return a / b; }
  if (op == "==") { if (a == b) { return 1; } return 0; }
  if (op == "!=") { if (a != b) { return 1; } return 0; }
  if (op == "<")  { if (a <  b) { return 1; } return 0; }
  if (op == ">")  { if (a >  b) { return 1; } return 0; }
  if (op == "<=") { if (a <= b) { return 1; } return 0; }
  if (op == ">=") { if (a >= b) { return 1; } return 0; }
  return 0;
}

// Resolve a name: env first, then fields.  (Tail-first scans.)
function lookup_name(env, fields, name: string) {
  var i: int = array_len(env) - 1;
  while (i >= 0) do {
    var pair = array_get(env, i);
    if (pair[0] == name) { return pair[1]; }
    i = i - 1;
  }
  var j: int = array_len(fields) - 1;
  while (j >= 0) do {
    var pair2 = array_get(fields, j);
    if (pair2[0] == name) { return pair2[1]; }
    j = j - 1;
  }
  return 0;
}

// Returns 1 if `name` is in env (local), 0 if it's only a field.
function name_is_local(env, name: string) {
  var i: int = array_len(env) - 1;
  while (i >= 0) do {
    var pair = array_get(env, i);
    if (pair[0] == name) { return 1; }
    i = i - 1;
  }
  return 0;
}

function eval_expr_actor(ast, env, fields, sched) {
  if (ast.tag == "Int") { return ast.val; }
  if (ast.tag == "Str") { return ast.val; }
  if (ast.tag == "Var") { return lookup_name(env, fields, ast.name); }
  if (ast.tag == "Binop") {
    var l = eval_expr_actor(ast.lhs, env, fields, sched);
    var r = eval_expr_actor(ast.rhs, env, fields, sched);
    return apply_binop(ast.op, l, r);
  }
  // Phase 17 carry: now target.method(args) — synchronous send.
  // Allocate a reply slot, enqueue with that slot, drive the
  // scheduler until the slot is filled, then return the value.
  if (ast.tag == "Now") {
    var arg_vals = eval_args(ast.args, env, fields, sched);
    var tgt = sched_lookup(sched, ast.target);
    if (tgt == 0) {
      print("[sched] now: unknown actor `" + ast.target + "`");
      return 0;
    }
    var slot_id: int = sched_alloc_slot(sched);
    actor_enqueue(tgt, {meth: ast.meth, args: arg_vals, slot: slot_id});
    var max_iter: int = 200;
    var iter: int = 0;
    var filled: int = 0;
    while (filled == 0) do {
      if (iter > max_iter) { filled = 1; }
      else {
        var slot = sched_get_slot(sched, slot_id);
        if (slot.filled == 1) { filled = 1; }
        else {
          var n = sched_step(sched);
          if (n == 0) { filled = 1; }
          iter = iter + 1;
        }
      }
    }
    var s = sched_get_slot(sched, slot_id);
    return s.value;
  }
  return 0;
}

function eval_args(args_ast, env, fields, sched) {
  var out = [];
  var i: int = 0;
  var n: int = array_len(args_ast);
  while (i < n) do {
    array_push(out, eval_expr_actor(array_get(args_ast, i), env, fields, sched));
    i = i + 1;
  }
  return out;
}

function eval_stmt_actor(s, env, fields, sched) {
  if (s.tag == "VarDecl") {
    var v = eval_expr_actor(s.expr, env, fields, sched);
    env_set_aipl(env, s.name, v);
    return v;
  }
  if (s.tag == "Assign") {
    var v = eval_expr_actor(s.expr, env, fields, sched);
    if (name_is_local(env, s.name) == 1) {
      env_set_aipl(env, s.name, v);
    } else {
      // mutate the actor field by appending — tail-first lookup wins.
      array_push(fields, (s.name, v));
    }
    return v;
  }
  if (s.tag == "Print") {
    var v = eval_expr_actor(s.expr, env, fields, sched);
    print(v);
    return 0;
  }
  if (s.tag == "If") {
    var c = eval_expr_actor(s.cond, env, fields, sched);
    if (c != 0) { return eval_stmt_list_actor(s.then_body, env, fields, sched); }
    return eval_stmt_list_actor(s.else_body, env, fields, sched);
  }
  if (s.tag == "While") {
    var c = eval_expr_actor(s.cond, env, fields, sched);
    while (c != 0) do {
      eval_stmt_list_actor(s.body, env, fields, sched);
      c = eval_expr_actor(s.cond, env, fields, sched);
    }
    return 0;
  }
  if (s.tag == "Send") {
    var arg_vals = eval_args(s.args, env, fields, sched);
    var tgt = sched_lookup(sched, s.target);
    if (tgt == 0) {
      print("[sched] send: unknown actor `" + s.target + "`");
      return 0;
    }
    actor_enqueue(tgt, {meth: s.meth, args: arg_vals, slot: 0});
    return 0;
  }
  // Reply(value) — fill the current message's reply slot.
  // The current msg's slot id is passed via env under the special
  // name "__slot__".
  if (s.tag == "Reply") {
    var v = eval_expr_actor(s.expr, env, fields, sched);
    var slot_id = lookup_name(env, fields, "__slot__");
    if (slot_id != 0) {
      sched_fill_slot(sched, slot_id, v);
    }
    return v;
  }
  if (s.tag == "Return") {
    return eval_expr_actor(s.expr, env, fields, sched);
  }
  return 0;
}

function eval_stmt_list_actor(stmts, env, fields, sched) {
  var i: int = 0;
  var n: int = array_len(stmts);
  while (i < n) do {
    eval_stmt_actor(array_get(stmts, i), env, fields, sched);
    i = i + 1;
  }
  return 0;
}

// =================================================================
// PART 4 — scheduler step / run.
// =================================================================

// Process one message on `actor`.  Returns 1 if a message was
// processed, 0 if the queue was empty.
function actor_step_one(actor, sched) {
  if (array_len(actor.queue) == 0) { return 0; }
  var msg = actor_dequeue(actor);
  var m = actor_method(actor, msg.meth);
  if (m == 0) {
    print("[sched] " + actor.name + ": unknown method `" + msg.meth + "`");
    return 1;
  }
  // bind params -> args in a fresh env, plus the special __slot__
  // marker so a Reply stmt inside the body can find its target.
  var env = [];
  env_set_aipl(env, "__slot__", msg.slot);
  var i: int = 0;
  var nparams: int = array_len(m.params);
  while (i < nparams) do {
    env_set_aipl(env, array_get(m.params, i), array_get(msg.args, i));
    i = i + 1;
  }
  eval_stmt_list_actor(m.body, env, actor.fields, sched);
  return 1;
}

// One round: each actor processes up to 1 message.  Returns total
// messages processed this round.
function sched_step(sched) {
  var processed: int = 0;
  var i: int = 0;
  var n: int = array_len(sched.actors);
  while (i < n) do {
    var pair = array_get(sched.actors, i);
    var a = pair[1];
    processed = processed + actor_step_one(a, sched);
    i = i + 1;
  }
  return processed;
}

// Run until idle or max_steps elapsed.
function sched_run(sched, max_steps: int) {
  var step: int = 0;
  var done: int = 0;
  while (done == 0) do {
    if (step >= max_steps) { done = 1; }
    else {
      var n = sched_step(sched);
      if (n == 0) { done = 1; }
      step = step + 1;
    }
  }
  print("[sched] ran " + step + " round(s)");
  return step;
}
