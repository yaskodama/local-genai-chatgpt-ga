// Level B-1 — Phase 11 Type Checker (AIPL implementation).
//
// Walks AST records (the same shape Level A's metacircular evaluator
// runs) and emits issue strings.  Builds on Level A's design:
//   * env / type-env: array of (name, value-or-type) tuples
//   * tail-first lookup so the latest binding wins
//   * per-call fresh env to avoid scope leaks
//
// Extensions to the AST shape vs Level A:
//   FunctionDecl param:  {name: "x", type: "int" | "any"}
//   FunctionDecl:        {name, params: [Param], return_type, body}
//   VarDecl with annotation:
//                        {tag:"VarDecl", name:"x", type:"int", expr:...}
//   VarDecl without:     {tag:"VarDecl", name:"x", type:"any", expr:...}
//
// A program for the type checker is:
//   {fns: [FunctionDecl…], main: [stmt…]}
// Issues come back as an array of strings: array_len > 0 means failure.

// ---------- type-env helpers (mirror meta_env_*) ----------

function tenv_get(env, name) {
  var i: int = array_len(env) - 1;
  while (i >= 0) do {
    var pair = array_get(env, i);
    if (pair[0] == name) {
      return pair[1];
    }
    i = i - 1;
  }
  return "any";
}

function tenv_set(env, name, ty) {
  array_push(env, (name, ty));
  return ty;
}

// ---------- function-table helpers ----------

function fns_lookup(fns, name) {
  var i: int = array_len(fns) - 1;
  while (i >= 0) do {
    var pair = array_get(fns, i);
    if (pair[0] == name) {
      return pair[1];
    }
    i = i - 1;
  }
  return 0;        // sentinel; caller checks via name-not-found path
}

function fns_register(fns, name, fn_decl) {
  array_push(fns, (name, fn_decl));
  return 0;
}

// ---------- type compatibility (port of aipl_typeck._compatible) ----------

// Hand-rolled splitter on `sep` since AIPL has no str_split.
function str_split_on(s: string, sep: string) {
  var out = [];
  var n: int = str_len(s);
  var sep_len: int = str_len(sep);
  var start: int = 0;
  var i: int = 0;
  while (i <= n - sep_len) do {
    if (str_sub(s, i, i + sep_len) == sep) {
      array_push(out, str_sub(s, start, i));
      i = i + sep_len;
      start = i;
    } else {
      i = i + 1;
    }
  }
  array_push(out, str_sub(s, start, n));
  return out;
}

function tc_compatible(expected: string, actual: string) {
  // any ~ any
  if (expected == "any") { return 1; }
  if (actual   == "any") { return 1; }
  if (expected == actual) { return 1; }
  // numeric promotion: int -> float
  if (expected == "float") {
    if (actual == "int") { return 1; }
  }
  // union (single-level): expected has "|"
  // We only handle single-pipe form like "int | string" without
  // nested containers — Phase 11+ container form needs Level B-2.
  if (str_contains(expected, "|") == 1) {
    var parts = str_split_on(expected, "|");
    var i: int = 0;
    var n: int = array_len(parts);
    while (i < n) do {
      var p = str_trim(array_get(parts, i));
      if (tc_compatible(p, actual) == 1) { return 1; }
      i = i + 1;
    }
    return 0;
  }
  return 0;
}

// ---------- expression type inference ----------
//
// Rules:
//   Int -> "int"
//   Str -> "string"
//   Var -> tenv_get
//   Binop:
//     +,-,*,/ on int×int -> int
//     +,-,*,/ on float|int×float|int -> float
//     + on string×any or any×string -> string  (concat)
//     ==, !=, <, >, <=, >= -> int (boolean as 0/1)
//   Call -> function's declared return_type, fall back to "any"

function tc_infer_expr(ast, tenv, fns, issues) {
  if (ast.tag == "Int") { return "int"; }
  if (ast.tag == "Str") { return "string"; }
  if (ast.tag == "Var") { return tenv_get(tenv, ast.name); }
  if (ast.tag == "Binop") {
    var lt = tc_infer_expr(ast.lhs, tenv, fns, issues);
    var rt = tc_infer_expr(ast.rhs, tenv, fns, issues);
    var op = ast.op;
    if (op == "==") { return "int"; }
    if (op == "!=") { return "int"; }
    if (op == "<")  { return "int"; }
    if (op == ">")  { return "int"; }
    if (op == "<=") { return "int"; }
    if (op == ">=") { return "int"; }
    // string concat with +
    if (op == "+") {
      if (lt == "string") { return "string"; }
      if (rt == "string") { return "string"; }
    }
    // numeric arithmetic
    if (lt == "float") { return "float"; }
    if (rt == "float") { return "float"; }
    return "int";
  }
  if (ast.tag == "Call") {
    var fn = fns_lookup(fns, ast.name);
    // arity + arg-type check happens here too
    var nparams: int = array_len(fn.params);
    var nargs: int = array_len(ast.args);
    if (nparams != nargs) {
      array_push(issues,
        "call to " + ast.name + ": arity " + nargs + " vs declared " + nparams);
    } else {
      var i: int = 0;
      while (i < nparams) do {
        var p = array_get(fn.params, i);
        var at = tc_infer_expr(array_get(ast.args, i), tenv, fns, issues);
        if (tc_compatible(p.type, at) == 0) {
          array_push(issues,
            "call to " + ast.name + " arg `" + p.name + "` mismatch (expected " + p.type + ", got " + at + ")");
        }
        i = i + 1;
      }
    }
    return fn.return_type;
  }
  // unknown tag — be permissive
  return "any";
}

// ---------- statement walking ----------
//
// Returns "fell_through" / "returned"; in B-1 we don't act on this
// distinction (no early-exit semantics matter for the type checker)
// but we still walk into Return.expr so its type can be checked
// against the enclosing function's return_type.
//
// `expected_ret` is the enclosing function's declared return type
// (or "any" at the top level).

function tc_check_stmt(s, tenv, fns, expected_ret, issues) {
  if (s.tag == "VarDecl") {
    var anno = s.type;
    var rhs_ty = tc_infer_expr(s.expr, tenv, fns, issues);
    if (anno != "any") {
      if (tc_compatible(anno, rhs_ty) == 0) {
        array_push(issues,
          "var `" + s.name + "` initializer mismatch (expected " + anno + ", got " + rhs_ty + ")");
      }
    }
    // Bind under the annotation if given, else under the inferred type.
    if (anno == "any") {
      tenv_set(tenv, s.name, rhs_ty);
    } else {
      tenv_set(tenv, s.name, anno);
    }
    return 0;
  }
  if (s.tag == "Assign") {
    var declared = tenv_get(tenv, s.name);
    var rhs_ty = tc_infer_expr(s.expr, tenv, fns, issues);
    if (declared != "any") {
      if (tc_compatible(declared, rhs_ty) == 0) {
        array_push(issues,
          "assign to `" + s.name + "` mismatch (declared " + declared + ", got " + rhs_ty + ")");
      }
    }
    return 0;
  }
  if (s.tag == "Print") {
    tc_infer_expr(s.expr, tenv, fns, issues);
    return 0;
  }
  if (s.tag == "If") {
    tc_infer_expr(s.cond, tenv, fns, issues);
    tc_check_stmt_list(s.then_body, tenv, fns, expected_ret, issues);
    tc_check_stmt_list(s.else_body, tenv, fns, expected_ret, issues);
    return 0;
  }
  if (s.tag == "While") {
    tc_infer_expr(s.cond, tenv, fns, issues);
    tc_check_stmt_list(s.body, tenv, fns, expected_ret, issues);
    return 0;
  }
  if (s.tag == "Return") {
    var rt = tc_infer_expr(s.expr, tenv, fns, issues);
    if (expected_ret != "any") {
      if (tc_compatible(expected_ret, rt) == 0) {
        array_push(issues,
          "return type mismatch (declared " + expected_ret + ", got " + rt + ")");
      }
    }
    return 0;
  }
  if (s.tag == "Call") {
    tc_infer_expr(s, tenv, fns, issues);
    return 0;
  }
  return 0;
}

function tc_check_stmt_list(stmts, tenv, fns, expected_ret, issues) {
  var i: int = 0;
  var n: int = array_len(stmts);
  while (i < n) do {
    tc_check_stmt(array_get(stmts, i), tenv, fns, expected_ret, issues);
    i = i + 1;
  }
  return 0;
}

// ---------- function body walking ----------

function tc_check_function(fn_decl, fns, issues) {
  // Per-call fresh env (mirrors Level A) — params bound under their
  // declared types.
  var tenv = [];
  var i: int = 0;
  var nparams: int = array_len(fn_decl.params);
  while (i < nparams) do {
    var p = array_get(fn_decl.params, i);
    tenv_set(tenv, p.name, p.type);
    i = i + 1;
  }
  tc_check_stmt_list(fn_decl.body, tenv, fns, fn_decl.return_type, issues);
  return 0;
}

// ---------- entry point ----------
//
// Returns issue list (array of strings).  Empty array = clean.

function tc_check_program(prog) {
  var issues = [];
  var fns = [];

  // Register functions so call-site lookups resolve forward refs.
  var i: int = 0;
  var n: int = array_len(prog.fns);
  while (i < n) do {
    var fn = array_get(prog.fns, i);
    fns_register(fns, fn.name, fn);
    i = i + 1;
  }

  // Walk each function body.
  i = 0;
  while (i < n) do {
    var fn2 = array_get(prog.fns, i);
    tc_check_function(fn2, fns, issues);
    i = i + 1;
  }

  // Walk the main statements with empty tenv + "any" return.
  var main_tenv = [];
  tc_check_stmt_list(prog.main, main_tenv, fns, "any", issues);

  return issues;
}
