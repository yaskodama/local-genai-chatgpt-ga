// Sample 3 — external writes are always flagged (pub or not).
//
//   acct.holder  = "stolen";       // ✗ pub but write banned
//   acct.balance = 999999;         // ✗ private + write banned

class Driver {
  method run() {
    print("=== Level B-5 — SampleExternalWrite ===");

    var bank = {
      name: "BankAccount",
      fields: [
        {name: "holder",  type: "string", is_pub: 1},
        {name: "balance", type: "int",    is_pub: 0}
      ],
      methods: []
    };

    var prog = {
      classes: [bank],
      fns: [],
      main: [
        {tag: "VarDecl", name: "acct", type: "any",
         expr: {tag: "New", cls_name: "BankAccount", args: []}},
        {tag: "FieldAssign", obj: "acct", field: "holder",
         expr: {tag: "Str", val: "stolen"}},
        {tag: "FieldAssign", obj: "acct", field: "balance",
         expr: {tag: "Int", val: 999999}}
      ]
    };

    var issues = tc_check_program(prog);
    print("issues=" + array_len(issues));
    var i = 0;
    while (i < array_len(issues)) do {
      print("  - " + array_get(issues, i));
      i = i + 1;
    }
    print("(expected: 2 — both holder & balance writes are flagged)");
  }
}

var d = new Driver();
send d.run();
