    print("遺伝子: paradigm=assembler; state_representation=register_integer; transition_style=increment_compare_jump; control_abstraction=labels_and_jumps; data_abstraction=none; encapsulation=none; type_safety=none; concurrency_model=none; executable_demo=tick_subroutine");
    print("突然変異: なし");
    print("交叉: なし");
    var assembly_base = task + "\n\n世代: Assembly\nbranch: main\narchive: AssemblyWinner\n遺伝子: paradigm=assembler; state_representation=register_integer; transition_style=increment_compare_jump; control_abstraction=labels_and_jumps; data_abstraction=none; encapsulation=none; type_safety=none; concurrency_model=none; executable_demo=tick_subroutine\n突然変異: なし\n交叉: なし\n評価観点: correctness, paradigm_fit";
    var assembly_1 = ai_call_with_system(generator_persona, assembly_base + "\n候補1 id=A1 style=minimal_registers。状態を1つのレジスタに置き、ADD/CMP/JMP で循環する。");
    var assembly_2 = ai_call_with_system(generator_persona, assembly_base + "\n候補2 id=A2 style=commented_labels。状態をメモリに置き、各色にラベルを付ける。");
    var assembly_3 = ai_call_with_system(generator_persona, assembly_base + "\n候補3 id=A3 style=named_addresses。LIGHT_STATE と RED/YELLOW/GREEN 定数を使う。");
    print("--- Assembly candidate 1 ---"); print(assembly_1);
    print("--- Assembly candidate 2 ---"); print(assembly_2);
    print("--- Assembly candidate 3 ---"); print(assembly_3);
    var assembly_payload = "世代 Assembly\\n候補:\\n1:\\n" + assembly_1 + "\n\n2:\n" + assembly_2 + "\n\n3:\n" + assembly_3;
    var assembly_r1 = ai_call_with_system(reviewer1_persona, assembly_payload);
    var assembly_r2 = ai_call_with_system(reviewer2_persona, assembly_payload);
