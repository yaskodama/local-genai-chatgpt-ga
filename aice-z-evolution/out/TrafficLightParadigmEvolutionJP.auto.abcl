class TrafficLightParadigmEvolutionJP_Auto {
  var task = "信号機 tick 問題を、プログラミング・パラダイムの進化として解く。信号機は Red -> Yellow -> Green -> Red の順に進み、複数回の tick を実演する。";
  var generator_persona = "あなたは進化計算の候補生成器です。指定された世代、親、遺伝子、突然変異、交叉に合う短い候補プログラムを1つ生成してください。説明は日本語で、候補コードは指定パラダイムに合わせて書いてください。最後に IMPROVES 行を1行だけ付けてください。";
  var reviewer1_persona = "あなたは正しさレビュアーです。3つの候補を、信号機遷移 Red -> Yellow -> Green -> Red の正しさ、遷移の完全性、tick 実演の分かりやすさで評価してください。簡潔な点数と最良候補番号を返してください。";
  var reviewer2_persona = "あなたはパラダイムレビュアーです。3つの候補を、その世代のプログラミング・パラダイムに合っているか、慣用的か、抽象化の段階が適切かで評価してください。簡潔な点数と最良候補番号を返してください。";
  var reviewer3_persona = "あなたは実装レビュアーです。3つの候補を、実行可能性、読みやすさ、進化しやすさ、型安全性で評価してください。簡潔な点数と最良候補番号を返してください。";
  var selector_persona = "あなたは選択器です。3つの候補と3つのレビューを読み、最良候補を1つ選んでください。出力は 1|2|3 のどれかだけにしてください。";
  var weights = "correctness=0.35, executability=0.20, paradigm_fit=0.15, readability=0.10, type_safety=0.10, evolvability=0.10";

  method run() {
    print("===== TrafficLightParadigmEvolutionJP_Auto =====");
