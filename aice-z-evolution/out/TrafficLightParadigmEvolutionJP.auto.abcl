    var paralleloop_r3 = ai_call_with_system(reviewer3_persona, paralleloop_payload);
    print("[review CorrectnessReviewer ParallelOOP]"); print(paralleloop_r1);
    print("[review ParadigmReviewer ParallelOOP]"); print(paralleloop_r2);
    print("[review EngineeringReviewer ParallelOOP]"); print(paralleloop_r3);
    var paralleloop_pick = ai_call_with_system(selector_persona, paralleloop_payload + "\n\nレビュー:\n" + paralleloop_r1 + "\n" + paralleloop_r2 + "\n" + paralleloop_r3);
    var ParallelOOPWinner = paralleloop_1;
    if (paralleloop_pick == "2") { ParallelOOPWinner = paralleloop_2; }
    if (paralleloop_pick == "3") { ParallelOOPWinner = paralleloop_3; }
    print("[selector picked ParallelOOP: " + paralleloop_pick + "]");
    print("[aice/archive] BEGIN ParallelOOPWinner"); print(ParallelOOPWinner); print("[aice/archive] END ParallelOOPWinner");
    print("");

    print("===== レポート =====");
    print("final_archive: ParallelOOPWinner");
    print(ai_usage());
  }
}

