aice LocalGenAIEvolutionJP {

  // ===================================================================
  // ローカル生成 AI を、 .aice の中だけで段階的に設計するための仕様。
  // 実機学習ではなく、 各候補が「アーキ + 学習レシピ + 期待指標」を
  // すべて持ち、 3 レビュアーが数値的に比較できる粒度で書く。
  // 工夫を .aice 側に集約することで、 候補生成器 / レビュアー / 選択器
  // が共通の前提と評価尺度の上で動く。
  // ===================================================================

  dialect = "aice_evolution_v1";

  task = "ローカル MacBook (M2, MPS, 16GB RAM) のみで動く byte 単位の生成 AI を、 7 世代で段階的に設計する。 各候補は『アーキ仕様 + 学習レシピ + 期待指標』の 3 つ組として提示し、 3 レビュアー (言語品質 / 効率 / 再現性) が共通の評価プロトコルで採点する。 共通プロトコルは [corpus=TinyShakespeare-first-100KB, split=95/5, metric=byte-level perplexity on holdout, seed=42, deps={python>=3.11, pytorch==2.x}, no_external_api, compute<=30min/candidate]。 各世代は前世代の 'archive winner' を親に取り、 突然変異と交叉で新候補を生む。 最終世代 SemiAutoEvolve は 3 レビュアーの累積点数を読み、 次に試すべき突然変異を 3 案、 aice の mutation ブロック形式で自分で起草する。 人間は採否を 1 つ選ぶ。 候補は実機学習結果を必要とせず、 設計推定式 (params, FLOPs, memory, expected_ppl) を根拠に比較できなければならない。";

  runtime {
    engine = "ocaml_abcl_cplus";
    executable = "dune exec ./src/repl_thread.exe";
  }

  archive {
    path = "aice-z-evolution/out/evolution/local_genai_jp/";
    final = "SemiAutoEvolveWinner";
  }

  policy {
    candidate_count = 3;
    reviewer_count = 3;
    selector_output = "1|2|3";
    language_mode = "natural_text_passthrough";
    formal_check = "external";
  }

  // === 共通設計推定式 (.aice の中で閉じる) ============================
  //   params(d, L, V, F) = 2*V*d + L * (4*d^2 + 2*d*F*d) + ctx*d
  //                       (tied_embed=true 前提、 LayerNorm の bias は無視)
  //   flops_per_token   ~ 2 * params + ctx * L * 4 * d
  //   activation_mem    ~ batch * ctx * L * d * 4 byte
  //   ppl_estimate      = empirical_chinchilla_for_local(params, train_tokens)
  //   train_time_estimate(M2 MPS) = (flops_per_step * steps) / 2.5e11
  // 各候補の prompt にこの 4 式の数値結果を入れること。
  // ===================================================================

  actors {
    generator = "候補生成器";
    designer  = "設計推定器";
    reviewer_quality = "言語品質レビュアー";
    reviewer_efficiency = "効率レビュアー";
    reviewer_reproducibility = "再現性レビュアー";
    selector = "選択器";
    archive = "アーカイブ";
  }

  reviewers {
    reviewer QualityReviewer {
      persona = "あなたは言語品質レビュアーです。 候補は (アーキ + 学習レシピ + 期待指標) の 3 つ組を出します。 共通評価プロトコルは task 末尾を参照。 採点は 4 軸 [holdout_ppl 期待値 / 学習中の loss 推移の合理性 / 既知の退化モードへの耐性 / 世代に対する過大設計の有無] でそれぞれ 0-3 点、 計 0-12 点。 holdout_ppl 期待値は (< 3.5: 3 点, < 4.5: 2 点, < 6.0: 1 点, それ以外: 0 点)。 各候補に 4 軸の点数と、 採点根拠を 2 行で添える。 最後に最良候補番号を 1 行で出す。";
      focus = "expected_holdout_ppl, loss_trajectory_plausibility, degeneracy_resistance, generation_appropriate_size";
    }

    reviewer EfficiencyReviewer {
      persona = "あなたは効率レビュアーです。 候補の (params, flops_per_token, activation_mem, train_time_estimate) を共通設計推定式で再計算し、 候補側の数値と矛盾がないか確認します。 採点は 4 軸 [ppl_per_param 効率 / params が世代上限内 / train_time が 30 分以内 / inference が KV キャッシュ等で改善] でそれぞれ 0-3 点、 計 0-12 点。 世代上限は (NGramFreq 64KB, CharRNN 200K params, TinyTransformer 1.5M, ImprovedMicroGPT 12M, DistilledMicro 12M, PreferenceTuned 12M, SemiAutoEvolve 12M)。 計算ミスや過大設計は減点。 最後に最良候補番号を 1 行で出す。";
      focus = "params_per_quality, world_param_budget, train_time_budget, inference_optimization";
    }

    reviewer ReproducibilityReviewer {
      persona = "あなたは再現性レビュアーです。 採点は 5 軸 [seed 固定 / corpus が SHA-256 でロックされている / 外部 API 不使用 / 依存が python>=3.11 と pytorch==2.x のみ / 単一スクリプトで train+eval が走る] それぞれ 0-2 点、 計 0-10 点。 1 つでも欠けたら -2 点。 候補が 'M2 MPS で 30 分以内' を主張しているのに train_time_estimate が超えていたら -3 点。 最後に最良候補番号を 1 行で出す。";
      focus = "seedable, corpus_pinned, no_external_api, minimal_deps, single_script";
    }
  }

  fitness {
    expected_holdout_ppl = 0.30;
    parameter_efficiency = 0.20;
    train_time_budget = 0.10;
    inference_efficiency = 0.10;
    reproducibility = 0.15;
    self_evolution_capability = 0.10;
    evolvability = 0.05;
  }

  mutations {
    // === 各 mutation には 'expected_delta' を必ず添える。 ==============
    // 候補生成器とレビュアーは expected_delta を超えたら警戒する。 ======

    mutation M1_NGram_to_CharRNN {
      kind = "paradigm_lift";
      changes = "model_family: ngram_count -> char_rnn; learning_paradigm: count_normalize -> SGD; representation: hash_table -> embedding+recurrent_state";
      expected_delta = "params: 32K -> 100K (3x); holdout_ppl: 8.5 -> 6.5 (-2.0); train_time: 0s -> 5min";
      reason = "頻度表から、 文字埋め込みと再帰隠れ状態を持つ小型 RNN へ。 同じコーパスで perplexity が 2 ポイント下がることを目標。";
    }

    mutation M2_CharRNN_to_TinyTransformer {
      kind = "structuring_mutation";
      changes = "model_family: char_rnn -> single_block_transformer; sequence_processing: time_step_recursion -> self_attention; receptive_field: bounded_by_hidden -> bounded_by_ctx_length";
      expected_delta = "params: 100K -> 1M (10x); holdout_ppl: 6.5 -> 5.0 (-1.5); train_time: 5min -> 15min";
      reason = "再帰の圧縮された隠れ状態から、 1 ブロック自己注意で文脈直接観測へ。 長距離依存と並列学習を獲得。";
    }

    mutation M3_Add_Positional_Embedding {
      kind = "representation_mutation";
      changes = "positional_embedding: none -> learned_or_sinusoidal_or_rope";
      expected_delta = "params: +ctx*d_model (~16K); holdout_ppl: -0.3";
      reason = "Transformer は順序情報を持たないため、 位置情報を入れる。 RoPE は外挿性能と引き換えにわずかに高コスト。";
    }

    mutation M4_Add_LayerNorm {
      kind = "training_stabilization_mutation";
      changes = "normalization: none -> pre_layernorm_or_rmsnorm";
      expected_delta = "params: +2*L*d_model (~3K for L=4); holdout_ppl: -0.1; gradient_norm: 安定 (発散を防ぐ)";
      reason = "層を増やすには Pre-LayerNorm (もしくは RMSNorm) が必要。 後段の M6 多層化を支える前提条件。";
    }

    mutation M5_Add_Dropout {
      kind = "regularization_mutation";
      changes = "regularization: none -> dropout_on_attention_and_ffn";
      expected_delta = "train_ppl: +0.3 ~ +0.6 (悪化); holdout_ppl: -0.2 ~ -0.5 (改善); train_time: +5%";
      reason = "小コーパスで丸暗記しないよう Dropout を入れる。 過学習が消えるが、 small d_model だと逆効果になりうる。";
    }

    mutation M6_Increase_Depth_and_Heads {
      kind = "scale_mutation";
      changes = "depth: 1 -> 4-8; n_heads: 1 -> 4-8; param_count_class: 1M -> 10M";
      expected_delta = "params: 1M -> 10M (10x); holdout_ppl: 5.0 -> 4.0 (-1.0); train_time: 15min -> 25min";
      reason = "工夫が一通り入ったあとで純粋にスケールアップ。 同じレシピで params 規模を上げ、 品質が伸びるかを測る。";
    }

    mutation M7_Add_KVCache_for_Inference {
      kind = "inference_optimization_mutation";
      changes = "inference_optimization: full_recompute_each_token -> kv_cache_incremental";
      expected_delta = "params: 0; holdout_ppl: 0; inference_throughput: x3-x10 (ctx に依存)";
      reason = "学習結果は変えず、 推論時のみ KV キャッシュで 1 トークンあたり計算量を一定化。";
    }

    mutation M8_Distill_from_Teacher {
      kind = "knowledge_compression_mutation";
      changes = "training_paradigm: maximum_likelihood -> hard_label + soft_label_distillation; teacher: previous_archive_winner";
      expected_delta = "params: 同等 or -50%; holdout_ppl: -0.3 ~ -0.6; train_time: +20%";
      reason = "前世代をそのまま教師にし、 同規模の生徒に soft label を渡して品質底上げ。 軽量だが教師と独立性は失う。";
    }

    mutation M9_Add_Preference_Tuning_DPO {
      kind = "alignment_mutation";
      changes = "training_paradigm: distillation -> distillation + DPO_lite; preference_data: three_reviewer_score_pairs";
      expected_delta = "holdout_ppl: ±0.1 (品質はほぼ不変); reviewer_consistency_score: +1.0 ~ +2.0";
      reason = "3 人レビュアーの過去点数から優劣ペアを作り、 DPO で選好に合わせる。 報酬モデル学習は省く軽量版。";
    }

    mutation M10_Add_SelfProposed_Mutations {
      kind = "meta_evolution_mutation";
      changes = "self_evolution: none -> model_proposes_next_3_mutations; loop_role: human_writes_aice -> model_drafts_aice_human_picks_one";
      expected_delta = "human_loop_time: -70% (1 案を書く時間 vs 3 案から選ぶ時間); novelty_score: +1.0; regression_risk: +0.5 (人間レビュー必須)";
      reason = "ここまでの aice 履歴とレビュー点数を渡し、 次の mutation 候補を 3 案、 mutation ブロック形式で自分で起草させる。 人間は採否を選ぶだけにする半自動ループ。";
    }
  }

  crossovers {
    crossover C1_RNN_plus_Attention_to_Hybrid {
      parents = "CharRNNWinner, TinyTransformerWinner";
      child = "HybridSeed";
      kind = "architecture_join_crossover";
      combine = "take CharRNN.recurrent_compression; take TinyTransformer.self_attention; replace sequence_processing with state_space + attention";
      expected_delta = "params: TinyTransformer 比 +10%; holdout_ppl: -0.2; long_ctx_quality: +1.0";
      reason = "再帰の安いステップ計算と注意の長距離依存を 1 ブロックに同居。 Mamba 系の state-space + attention 混成。";
    }

    crossover C2_Distill_plus_DPO_to_Aligned {
      parents = "DistilledMicroWinner, PreferenceTunedWinner";
      child = "AlignedLocalSeed";
      kind = "training_pipeline_crossover";
      combine = "take DistilledMicro.soft_label; take DistilledMicro.compact_params; take PreferenceTuned.reviewer_pairs; replace training with distill_then_DPO";
      expected_delta = "holdout_ppl: -0.2 (蒸留分); reviewer_consistency: +1.5 (DPO 分); train_time: +30%";
      reason = "蒸留で底上げし、 その上に DPO を掛ける 2 段パイプラインに統合。";
    }

    crossover C3_Reviewer_Score_to_Mutation_Proposal {
      parents = "PreferenceTunedWinner, SemiAutoEvolveSeed";
      child = "SemiAutoEvolveWinnerSeed";
      kind = "meta_loop_crossover";
      combine = "take PreferenceTuned.score_pairs; take SemiAutoEvolveSeed.self_drafted_mutations; replace mutation_source with reviewer_grounded_self_proposal";
      expected_delta = "self_proposal_acceptance_rate: 0.33 -> 0.6; novelty: +0.5";
      reason = "3 レビュアーの過去点数を、 モデルが次の変異を提案するときの根拠データとして渡す。 半自動ループの提案精度を上げる。";
    }
  }

  stages {

    stage NGramFreq {
      order = 1;
      branch = "main";
      parents = "";
      archive = "NGramFreqWinner";
      genome = "model_family=ngram_count; n=3; vocab=byte_256; smoothing=add_one_laplace; param_count_estimate=32KB-table; train_paradigm=count_normalize; engine=numpy_only; expected_holdout_ppl=8.0-10.0; train_time=0s; inference=O(1)_table_lookup; failure_modes={oov_blowup, low_diversity}; common_eval=TinyShakespeare-100KB-seed42";
      mutations = "";
      crossover = "";
      focus = "reproducibility, parameter_efficiency, common_baseline";

      candidates {
        candidate N1 {
          style = "char_bigram_laplace";
          prompt = "[N1 char_bigram_laplace] arch: bigram count table, vocab=256, n=2, smoothing=Laplace(alpha=1). レシピ: pass corpus once, normalize per-row. 期待: params ≒ 256*256*4byte = 256KB-table, holdout_ppl ≒ 9.0, train_time = 1s, inference = O(1). 既知の退化: high-entropy fallback when next byte unseen. 出力: ngram_train.py (40 行以内), ngram_eval.py。 共通評価プロトコルに従う。";
        }
        candidate N2 {
          style = "char_trigram_with_backoff";
          prompt = "[N2 char_trigram_with_backoff] arch: trigram counts + bigram backoff (Katz-style without discount). 期待: params ≒ 256^3 sparse ≒ 200KB (実コーパスで疎), holdout_ppl ≒ 8.0, train_time = 2s. 既知の退化: コーパスにない trigram で backoff の連鎖。 出力: ngram_train.py + backoff_eval.py。";
        }
        candidate N3 {
          style = "byte_unigram_only";
          prompt = "[N3 byte_unigram_only] arch: 単純な byte 出現確率のみ。 比較対象としての下限。 期待: params = 256*4byte = 1KB, holdout_ppl ≒ 12-15 (上振れ), train_time < 0.1s。 これより悪い候補は世代失格。";
        }
      }
    }

    stage CharRNN {
      order = 2;
      branch = "main";
      parents = "NGramFreqWinner";
      archive = "CharRNNWinner";
      genome = "model_family=char_rnn; cell=GRU_or_LSTM; embed_dim=64; hidden_dim=128; layers=1; vocab=256; ctx=128; tied_embedding=true; param_count_estimate=100K-150K; train_paradigm=AdamW; engine=pytorch_cpu; expected_holdout_ppl=6.0-7.0; train_time<=5min_M2_CPU; inference=sequential_O_n; failure_modes={hidden_state_explode, slow_inference, no_long_range}; mutations_applied=M1";
      mutations = "M1_NGram_to_CharRNN";
      crossover = "";
      focus = "expected_holdout_ppl, parameter_efficiency, training_efficiency";

      candidates {
        candidate R1 {
          style = "single_layer_GRU_tied";
          prompt = "[R1 single_layer_GRU_tied] arch: embed=64, GRU(hidden=128, layers=1), tied input/output embedding. レシピ: AdamW(lr=3e-3, wd=0.01), batch=64, BPTT_len=128, steps=2000, warmup=200, grad_clip=1.0, dropout=0, seed=42. 期待: params ≒ 2*256*64 + 3*(64+128)*128 + 256 ≒ 110K, holdout_ppl ≒ 6.3, train_time ≒ 4 min M2 CPU. 出力: rnn_train.py, rnn_eval.py。";
        }
        candidate R2 {
          style = "single_layer_LSTM_untied";
          prompt = "[R2 single_layer_LSTM_untied] arch: embed=64, LSTM(hidden=128, layers=1), untied. レシピ: 同上。 期待: params ≒ 256*64 + 4*(64+128)*128 + 128*256 ≒ 145K, holdout_ppl ≒ 6.5 (LSTM は forget gate のおかげでやや安定だが params 多), train_time ≒ 4.5 min。 比較対象として残す。";
        }
        candidate R3 {
          style = "GRU_with_input_dropout";
          prompt = "[R3 GRU_with_input_dropout] arch: R1 と同じだが embedding 直後に dropout=0.1。 期待: params 同じ ≒ 110K, holdout_ppl ≒ 6.1 (汎化分の改善), train_ppl 上昇 ≒ +0.4, train_time ≒ +5%。 dropout の早すぎる導入が逆効果になる場合の参照点。";
        }
      }
    }

    stage TinyTransformer {
      order = 3;
      branch = "main";
      parents = "CharRNNWinner";
      archive = "TinyTransformerWinner";
      genome = "model_family=single_block_transformer; depth=1; n_heads=4; d_model=128; ffn_mult=4; vocab=256; ctx=128; positional=rope_or_learned; norm=pre_layernorm; dropout=0; tied_embedding=true; param_count_estimate=600K-1.0M; train_paradigm=AdamW; engine=pytorch_cpu_or_mps; expected_holdout_ppl=5.0-5.5; train_time<=15min_M2_MPS; inference=full_attention_O_n2; failure_modes={no_position_signal_if_skipped, layernorm_misplaced, attention_entropy_collapse}; mutations_applied=M2+M3+M4";
      mutations = "M2_CharRNN_to_TinyTransformer, M3_Add_Positional_Embedding, M4_Add_LayerNorm";
      crossover = "C1_RNN_plus_Attention_to_Hybrid optional";
      focus = "expected_holdout_ppl, parameter_efficiency, generation_appropriate_size";

      candidates {
        candidate T1 {
          style = "depth1_h4_d128_rope_rmsnorm";
          prompt = "[T1 depth1_h4_d128_rope_rmsnorm] arch: depth=1, n_heads=4, d_model=128, ffn_mult=4, RoPE, RMSNorm, tied_embed. レシピ: AdamW(lr=3e-3, betas=(0.9,0.95), wd=0.1), batch=64, ctx=128, steps=3000, warmup=300, grad_clip=1.0, seed=42, MPS. 期待: params ≒ 2*256*128 + 1*(4*128^2 + 2*128*4*128) + 128*128 ≒ 200K (注: tied なので embed*2 を 1 とすると 80K ぶん減る、 計 ≒ 660K)。 詳細: attn ≒ 65K + ffn ≒ 130K + LN ≒ 0.3K + ctx_pos ≒ 16K (RoPE は params 0)。 合計 ≒ 720K。 holdout_ppl ≒ 5.2, train_time ≒ 12 min MPS。 出力: tx_train.py, tx_infer.py。";
        }
        candidate T2 {
          style = "depth1_h4_d128_learned_pos_layernorm";
          prompt = "[T2 depth1_h4_d128_learned_pos_layernorm] arch: T1 と同じだが positional は learned_absolute(ctx*d_model)、 norm は LayerNorm。 期待: params +16K (位置埋め込み), 計 ≒ 730K, holdout_ppl ≒ 5.4 (RoPE よりわずかに悪い), train_time ≒ 13 min。 比較対象。";
        }
        candidate T3 {
          style = "depth1_h2_d96_rope";
          prompt = "[T3 depth1_h2_d96_rope] arch: 縮小版。 depth=1, n_heads=2, d_model=96, ffn_mult=4, RoPE. params ≒ 2*256*96 + 4*96^2 + 2*96*4*96 ≒ 130K (tied), holdout_ppl ≒ 5.7 (params 半減で品質も少し落ちる), train_time ≒ 8 min。 効率重視枝の参照点。";
        }
      }
    }

    stage ImprovedMicroGPT {
      order = 4;
      branch = "improvement_path";
      parents = "TinyTransformerWinner";
      archive = "ImprovedMicroGPTWinner";
      genome = "model_family=multi_block_transformer; depth=4; n_heads=4; d_model=192; ffn_mult=4; vocab=256; ctx=256; positional=rope; norm=pre_rmsnorm; dropout=0.1; tied_embedding=true; param_count_estimate=2.5M-3.5M; train_paradigm=AdamW_with_cosine_decay; engine=pytorch_mps; expected_holdout_ppl=4.0-4.5; train_time<=25min_M2_MPS; inference=kv_cache; failure_modes={dropout_too_high_for_small_corpus, lr_spike_at_warmup, attention_oscillation}; mutations_applied=M5+M6+M7";
      mutations = "M5_Add_Dropout, M6_Increase_Depth_and_Heads, M7_Add_KVCache_for_Inference";
      crossover = "";
      focus = "expected_holdout_ppl, parameter_efficiency, inference_efficiency";

      candidates {
        candidate G1 {
          style = "depth4_h4_d192_drop01_kvcache";
          prompt = "[G1 depth4_h4_d192_drop01_kvcache] arch: depth=4, n_heads=4, d_model=192, ffn_mult=4, RoPE, RMSNorm, dropout=0.1, tied_embed, KV cache for inference. レシピ: AdamW(lr=3e-4, betas=(0.9,0.95), wd=0.1), cosine decay to 3e-5, batch=32, ctx=256, steps=4000, warmup=400, grad_clip=1.0, seed=42, MPS, bf16 mixed. 期待: params ≒ 2*256*192 + 4*(4*192^2 + 2*192*4*192) ≒ 2.5M (tied で -100K), holdout_ppl ≒ 4.1, train_time ≒ 22 min, infer ≒ x4 with KV cache。 出力: gpt_train.py, gpt_infer_with_kvcache.py。";
        }
        candidate G2 {
          style = "depth8_h4_d160_drop005_kvcache";
          prompt = "[G2 depth8_h4_d160_drop005_kvcache] arch: depth=8, n_heads=4, d_model=160, ffn_mult=4, dropout=0.05 (深い分減らす)。 レシピ: 同上, steps=5000。 期待: params ≒ 8*(4*160^2 + 2*160*4*160) ≒ 3.3M, holdout_ppl ≒ 3.9 (深さで稼ぐ), train_time ≒ 28 min (上限ぎりぎり), infer x3 with KV. 効率は G1 並、 品質はわずかに上。";
        }
        candidate G3 {
          style = "depth4_h8_d192_grouped_kvcache";
          prompt = "[G3 depth4_h8_d192_grouped_kvcache] arch: depth=4, n_heads=8 (head_dim=24), d_model=192, ffn_mult=4, dropout=0.1, RoPE。 head_dim を小さくしてヘッド数を倍にする。 期待: params 同等 ≒ 2.5M, holdout_ppl ≒ 4.05 (頭数増で頭ごとの専門化), train_time 同等。 head_dim 24 は MPS で速い (8 の倍数)。";
        }
      }
    }

    stage DistilledMicro {
      order = 5;
      branch = "improvement_path";
      parents = "ImprovedMicroGPTWinner";
      archive = "DistilledMicroWinner";
      genome = "model_family=multi_block_transformer_compact; depth=4; n_heads=4; d_model=160; ffn_mult=4; vocab=256; ctx=256; positional=rope; norm=pre_rmsnorm; dropout=0.1; tied_embedding=true; param_count_estimate=1.8M-2.2M; train_paradigm=hard_label+soft_label_distillation; teacher=ImprovedMicroGPTWinner; distill_temperature=2.0; loss_mix=alpha*KL(student||teacher_soft) + (1-alpha)*CE(student, hard); alpha=0.5; engine=pytorch_mps; expected_holdout_ppl=3.8-4.1; train_time<=27min_M2_MPS; mutations_applied=M8";
      mutations = "M8_Distill_from_Teacher";
      crossover = "";
      focus = "expected_holdout_ppl, parameter_efficiency, training_efficiency";

      candidates {
        candidate DI1 {
          style = "soft_label_T2_alpha05";
          prompt = "[DI1 soft_label_T2_alpha05] arch: G1 を縮小 (d_model=160) した生徒。 教師 = ImprovedMicroGPTWinner。 レシピ: alpha=0.5, T=2.0, AdamW(lr=3e-4 wd=0.1), batch=32, ctx=256, steps=4500, warmup=400, MPS. 期待: params ≒ 1.9M (G1 から ~25% 縮小), holdout_ppl ≒ 4.0 (教師に追いつく), train_time ≒ 25 min。 蒸留で 'params 半分でも品質維持' を狙う。";
        }
        candidate DI2 {
          style = "soft_label_plus_intermediate_match";
          prompt = "[DI2 soft_label_plus_intermediate_match] arch: DI1 と同じだが各層の出力 hidden state も MSE で教師に合わせる (FitNets 風)。 損失 = alpha*KL + beta*MSE_hidden + (1-alpha-beta)*CE, alpha=0.4, beta=0.2。 期待: params 同じ 1.9M, holdout_ppl ≒ 3.9, train_time +15%。 教師との生徒層数が一致 (4=4) 必要。";
        }
        candidate DI3 {
          style = "data_only_distill";
          prompt = "[DI3 data_only_distill] arch: 教師に追加 byte 列 1MB を生成させ、 そのデータで生徒を素直に CE 学習。 教師 logits は使わない。 利点は実装が hard label のみで済むこと。 期待: params 1.9M, holdout_ppl ≒ 4.2 (DI1 より 0.2 悪い), train_time ≒ 22 min + 教師生成 5 min。 単純さ重視枝。";
        }
      }
    }

    stage PreferenceTuned {
      order = 6;
      branch = "alignment_path";
      parents = "DistilledMicroWinner";
      archive = "PreferenceTunedWinner";
      genome = "model_family=multi_block_transformer_compact; depth=4; n_heads=4; d_model=160; ffn_mult=4; param_count_estimate=1.8M-2.2M+lora_overhead; train_paradigm=distillation+DPO_lite; preference_data=three_reviewer_score_top_vs_bottom_pairs; reference_model=DistilledMicroWinner_frozen; beta=0.1; algorithm=DPO_with_KL_anchor; engine=pytorch_mps; expected_holdout_ppl=3.9-4.1; expected_reviewer_consistency=+1.5; mutations_applied=M9";
      mutations = "M9_Add_Preference_Tuning_DPO";
      crossover = "C2_Distill_plus_DPO_to_Aligned";
      focus = "expected_holdout_ppl, reproducibility, reviewer_consistency";

      candidates {
        candidate PT1 {
          style = "pairs_top_vs_bottom_full_finetune";
          prompt = "[PT1 pairs_top_vs_bottom_full_finetune] 過去 5 世代の 3 レビュアー累積点で各世代の最上位 vs 最下位を優劣ペア化、 計 5*3 = 15 ペア (足りなければ世代内 1 vs 3 も追加して 30 ペアに揃える)。 損失 = -log sigmoid(beta*(log p_pi(y_w|x) - log p_ref(y_w|x) - log p_pi(y_l|x) + log p_ref(y_l|x))), beta=0.1。 ref = DistilledMicroWinner frozen。 全パラメータ更新。 lr=1e-5, steps=200, MPS。 期待: holdout_ppl ≒ 4.0 (ほぼ不変), reviewer_consistency +1.5。";
        }
        candidate PT2 {
          style = "kl_anchored_full_finetune";
          prompt = "[PT2 kl_anchored_full_finetune] PT1 と同じだが KL を陽に項として足す (loss += lambda * KL(pi || ref), lambda=0.05)。 reviewer に過剰最適化して holdout_ppl が悪化するのを防ぐ。 期待: holdout_ppl ≒ 3.95, reviewer_consistency +1.2 (PT1 より控えめ)。";
        }
        candidate PT3 {
          style = "three_axis_separate_lora";
          prompt = "[PT3 three_axis_separate_lora] LoRA(rank=8) を 3 つ用意し、 言語品質 / 効率 / 再現性 軸ごとに別 LoRA で DPO する。 推論時はすべて加算。 LoRA params ≒ 3 * 2 * d_model * rank * depth = 3*2*160*8*4 ≒ 30K (本体 1.9M に対して微小)。 期待: holdout_ppl ≒ 4.0, reviewer_consistency +1.7 (3 軸でバランスする), 学習 +20%。 軸ごとのトレードオフを見たいときに有効。";
        }
      }
    }

    stage SemiAutoEvolve {
      order = 7;
      branch = "join";
      parents = "PreferenceTunedWinner, ImprovedMicroGPTWinner";
      archive = "SemiAutoEvolveWinner";
      genome = "model_family=multi_block_transformer_compact_self_evolving; depth=4; n_heads=4; d_model=160; ffn_mult=4; param_count_estimate=1.8M-2.2M+lora_overhead; train_paradigm=distill_then_DPO_then_self_proposed_mutation; self_evolution=model_drafts_3_mutations_human_picks_one; loop_protocol={input=[full_aice_history, mutation_log, reviewer_scores_per_stage, fitness_trajectory], output=[3_mutation_blocks_in_aice_format_with_expected_delta], filtering=human_picks_one, regression_guard=next_holdout_ppl_must_not_increase_by_more_than_0.2}; engine=pytorch_mps; expected_holdout_ppl=3.8-4.0; mutations_applied=M10";
      mutations = "M10_Add_SelfProposed_Mutations";
      crossover = "C3_Reviewer_Score_to_Mutation_Proposal";
      focus = "self_evolution_capability, evolvability, reproducibility";

      candidates {
        candidate SE1 {
          style = "model_drafts_three_mutations";
          prompt = "[SE1 model_drafts_three_mutations] 入力 = [これまでの aice 全文, mutations 履歴, 各世代の 3 レビュアー累積点数]。 出力 = mutation ブロック 3 つ (mutation Mxx_Name { kind, changes, expected_delta, reason })。 各 mutation は独立で、 'なぜ今これか' を reason 1 行に書く。 既存変異との重複を禁止 (名前ベースで dedupe)。 人間は 1 つ選ぶ。 自己提案受理率 0.33 -> 0.6 を目標。";
        }
        candidate SE2 {
          style = "model_writes_full_next_stage";
          prompt = "[SE2 model_writes_full_next_stage] SE1 をさらに進めて、 mutation だけでなく次の stage 全体 (genome + 3 candidates + 期待 fitness) を 1 つ起草する。 人間は採否のみ判断。 リスク: regression_guard (次世代 holdout_ppl を 0.2 以上悪化させない) を満たさないと拒否。 利点: aice の編集コストが大幅に下がる。";
        }
        candidate SE3 {
          style = "model_critiques_then_proposes";
          prompt = "[SE3 model_critiques_then_proposes] 前世代の最良候補の弱点を 3 行で自己批評し、 その弱点を埋める変異だけを 3 案提案。 各変異は弱点との対応を 1 行で示す。 多様性は減るが提案精度は上がる。 過去 stage で reviewer 点数が伸び悩んだ軸 (例: 効率) を狙い撃ちにできる。";
        }
      }
    }
  }
}
