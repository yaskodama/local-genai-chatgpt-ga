aice DeadlockVerificationEvolutionJP {

  dialect = "aice_evolution_v1";

  task = "ダイニング哲学者問題のデッドロックを、検証パラダイムの段階的進化として扱う。素朴な print デバッグから、実行時 assertion、ファズテスト、有界モデル検査、SPIN/Promela、TLA+/TLC、構造的修正、線形型による予防まで、それぞれの世代で哲学者プログラムをどう書き、どう検査するかを示す。最終世代では、線形型で構築上デッドロック不能な版が、SPIN と TLA+ の両方で 0 違反として確認される。";

  runtime {
    engine = "ocaml_abcl_cplus";
    executable = "dune exec ./src/repl_thread.exe";
  }

  archive {
    path = "aice-z-evolution/out/evolution/deadlock_verification_jp/";
    final = "ProvenAndCheckedWinner";
  }

  policy {
    candidate_count = 3;
    reviewer_count = 3;
    selector_output = "1|2|3";
    language_mode = "natural_text_passthrough";
    formal_check = "external";
  }

  actors {
    generator = "候補生成器";
    reviewer_correctness = "正しさレビュアー";
    reviewer_paradigm = "パラダイムレビュアー";
    reviewer_engineering = "実装レビュアー";
    selector = "選択器";
    archive = "アーカイブ";
  }

  reviewers {
    reviewer CorrectnessReviewer {
      persona = "あなたは正しさレビュアーです。3つの候補を、ダイニング哲学者問題のデッドロック検出または予防という観点から評価してください。生 5 哲学者の素朴版で必ずデッドロックが見えること、ordered 版でデッドロックが報告されないことを優先します。簡潔な点数と最良候補番号を返してください。";
      focus = "deadlock_detection, false_positive_rate, ordered_safe";
    }

    reviewer ParadigmReviewer {
      persona = "あなたはパラダイムレビュアーです。3つの候補を、その世代の検証パラダイム（print/assert/fuzz/bounded/SPIN/TLA+/structural/typed）に忠実か、世代の手法を慣用的に使えているか、その世代でしか書けない強みが出ているかで評価してください。簡潔な点数と最良候補番号を返してください。";
      focus = "paradigm_fit, idiomatic_use, generation_specific_strength";
    }

    reviewer EngineeringReviewer {
      persona = "あなたは実装レビュアーです。3つの候補を、再現性（同じコマンドで同じ結果が出るか）、最小手順、状態空間サイズに対するスケーラビリティ、反例の読みやすさで評価してください。簡潔な点数と最良候補番号を返してください。";
      focus = "reproducibility, minimality, scalability, counter_example_readability";
    }
  }

  fitness {
    correctness = 0.30;
    executability = 0.15;
    paradigm_fit = 0.15;
    scalability = 0.15;
    counter_example_readability = 0.10;
    type_safety = 0.10;
    evolvability = 0.05;
  }

  mutations {
    mutation M1_Print_to_Assert {
      kind = "observation_lift_mutation";
      changes = "verification_paradigm: print_debug -> runtime_assertion; observation_method: human_log_reading -> automatic_invariant_check";
      reason = "print 文に頼った人手の観察を、各 actor が自分の不変条件を assert する自動チェックへ持ち上げる。";
    }

    mutation M2_Assert_to_Fuzz {
      kind = "exploration_mutation";
      changes = "verification_paradigm: runtime_assertion -> random_fuzz_with_timeout; coverage_method: single_run -> repeated_runs_with_random_scheduling";
      reason = "1回の実行に依存した assert を、ランダム scheduler とタイムアウトを使って多数回試す方式に進める。";
    }

    mutation M3_Fuzz_to_Bounded {
      kind = "exhaustiveness_mutation";
      changes = "verification_paradigm: random_fuzz_with_timeout -> bounded_BFS_state_search; coverage_method: probabilistic_sampling -> exhaustive_within_depth_bound; property_language: implicit_in_test -> explicit_LTL_lite";
      reason = "確率的サンプリングを、BFS による有界完全探索と、G/F/¬/∧/∨ の LTL-lite による明示的性質宣言に置き換える。aipl_modelcheck を呼び出す。";
    }

    mutation M4_Bounded_to_Promela {
      kind = "external_checker_lift_mutation";
      changes = "verification_paradigm: bounded_BFS_state_search -> SPIN_Promela_exhaustive; engine: in_process_python -> external_compiled_pan; channel_model: implicit_python_list -> bounded_chan_capacity";
      reason = "Python の有界探索を、aipl_to_promela で .pml に書き出し、SPIN/pan で実行する外部・網羅探索に持ち上げる。chan の容量を陽に与える点が違う。";
    }

    mutation M5_Bounded_to_TLA {
      kind = "external_checker_lift_mutation";
      changes = "verification_paradigm: bounded_BFS_state_search -> TLA_TLC_declarative; engine: in_process_python -> external_TLC; action_style: imperative_step_function -> action_predicate_with_primes; mailbox_model: list_with_index -> Sequences_with_Append_Tail";
      reason = "Python の有界探索を、aipl_to_tla で .tla/.cfg に書き出し、TLC で実行する宣言的・網羅探索に持ち上げる。actor のステップを action 述語として書ける点が違う。";
    }

    mutation M6_Symptom_to_Resource_Hierarchy {
      kind = "structural_fix_mutation";
      changes = "verification_paradigm: detection -> structural_prevention; fix_kind: ad_hoc_retry -> ordered_resource_acquisition; phil_layout: circular_naive -> ordered_lo_then_hi";
      reason = "検出された反例（全員が lo を握ったまま hi を待つ）を読み、Phil の引数を「lo は hi より小さい id」に整え、循環を断つ。コードを書き換える構造的修正。";
    }

    mutation M7_Untyped_to_Linear_Channel {
      kind = "static_prevention_mutation";
      changes = "verification_paradigm: structural_convention -> typed_static_prevention; channel_kind: shared_mailbox -> linear_owned_channel; ownership: by_convention -> by_type_system";
      reason = "「lo は hi より小さい」を慣習でなく型として表す。Phase 11–15 の linear/owned チャネルで、デッドロックパターン（同じ fork を 2 個所が同時に持つ）が型エラーになるよう作り直す。";
    }

    mutation M8_Add_LTL_Property {
      kind = "property_strengthening_mutation";
      changes = "property_language: invalid_end_state_only -> explicit_LTL_with_progress; safety: implicit -> G_not_all_hungry_holding_lo; liveness: implicit -> F_all_done";
      reason = "「実行が止まらない」だけでは弱いので、安全性 G ¬all_hungry_holding_lo と進行性 F all_done を陽に書き、検査器に渡す。";
    }

    mutation M9_Add_Counter_Example_Trace {
      kind = "diagnostic_mutation";
      changes = "diagnostic: pass_fail_only -> recorded_counter_example_trace; trace_format: implicit -> per_step_world_snapshot";
      reason = "violated 報告だけでなく、初期状態から違反状態までの 1 ステップずつのワールドスナップショットを返し、開発者が原因を辿れるようにする。";
    }

    mutation M10_Combine_Typed_and_Checked {
      kind = "double_assurance_mutation";
      changes = "verification_paradigm: typed_static_prevention -> typed_plus_externally_checked; assurance_chain: type_check_only -> type_check_then_SPIN_then_TLC";
      reason = "型で構築上不可能と言うだけでは「型システムが正しい」前提に頼る。線形版を SPIN と TLA+ の両方に流し、どちらも 0 違反であることまで確認する。";
    }
  }

  crossovers {
    crossover C1_SPIN_TLA_to_BackendAbstraction {
      parents = "PromelaSPINWinner, TLAPlusTLCWinner";
      child = "BackendAbstractionSeed";
      kind = "engine_join_crossover";
      combine = "take PromelaSPINWinner.bounded_chan_model; take PromelaSPINWinner.LTL_progress_property; take TLAPlusTLCWinner.action_predicate_style; take TLAPlusTLCWinner.declarative_invariant; replace engine with abstract_backend_dispatch";
      reason = "SPIN の操作的なチャネルモデルと、TLA+ の宣言的な action/invariant を 1 つの抽象バックエンド層にまとめ、どちらにも export できるようにする。";
    }

    crossover C2_Bounded_to_OrderedFix_via_CounterExample {
      parents = "BoundedModelCheckWinner";
      child = "OrderedAcquisitionSeed";
      kind = "diagnostic_to_fix_crossover";
      combine = "take BoundedModelCheckWinner.counter_example_trace; take BoundedModelCheckWinner.deadlock_state_signature; replace phil_layout with ordered_lo_then_hi; add structural_fix_explanation_in_comment";
      reason = "有界モデル検査が出した反例トレース（全員 hungry, 全員 got_lo）から、構造的な修正案（lo を id 順に取る）を提案し、AIPL ソースを書き換える。";
    }

    crossover C3_OrderedConvention_to_TypedLinear {
      parents = "OrderedAcquisitionWinner, BoundedModelCheckWinner";
      child = "TypedLinearSeed";
      kind = "convention_to_type_crossover";
      combine = "take OrderedAcquisitionWinner.ordered_lo_then_hi_invariant; take BoundedModelCheckWinner.LTL_safety_property; replace ordering_enforcement with linear_typed_channel; lift fork_id_total_order into channel_phantom_type";
      reason = "「lo < hi」を慣習でなく型レベル不変条件に変換し、不正な順序の取得を型エラーにする。線形所有とあわせて、複数 phil が同じ fork を同時に保持できないことも型で保証する。";
    }
  }

  stages {
    stage PrintDebug {
      order = 1;
      branch = "main";
      parents = "";
      archive = "PrintDebugWinner";
      genome = "verification_paradigm=print_debug; observation_method=human_log_reading; property_language=none; engine=in_process_AIPL; phil_layout=circular_naive; channel_kind=shared_mailbox; ownership=none; assurance_chain=none; counter_example_trace=none";
      mutations = "";
      crossover = "";
      focus = "correctness, paradigm_fit";

      candidates {
        candidate D1 { style = "print_each_send";       prompt = "各 send/recv 直後に print し、デッドロックは目視で気付かせる。"; }
        candidate D2 { style = "print_only_on_state";   prompt = "got_lo / done / meals が変わったときだけ print する。"; }
        candidate D3 { style = "print_with_step_count"; prompt = "step 番号付きで print し、止まったら止まった step を記録する。"; }
      }
    }

    stage Assertion {
      order = 2;
      branch = "main";
      parents = "PrintDebugWinner";
      archive = "AssertionWinner";
      genome = "verification_paradigm=runtime_assertion; observation_method=automatic_invariant_check; property_language=inline_boolean; engine=in_process_AIPL; phil_layout=circular_naive; assurance_chain=runtime_assert_only; counter_example_trace=last_failing_assert";
      mutations = "M1_Print_to_Assert";
      crossover = "";
      focus = "correctness, evolvability";

      candidates {
        candidate AS1 { style = "fork_assert_held_consistent"; prompt = "Fork.held と queue 長さが矛盾しないことを各 method の出口で assert する。"; }
        candidate AS2 { style = "phil_assert_meals_nonneg";    prompt = "Phil.meals が負にならない、done==1 になったら meals==0 という invariant を assert する。"; }
        candidate AS3 { style = "system_assert_no_double_grant"; prompt = "1 つの fork が同時に 2 つの phil に granted を返さないことを assert する。"; }
      }
    }

    stage RandomFuzz {
      order = 3;
      branch = "main";
      parents = "AssertionWinner";
      archive = "RandomFuzzWinner";
      genome = "verification_paradigm=random_fuzz_with_timeout; observation_method=repeated_runs_with_random_scheduling; property_language=inline_boolean_plus_timeout; engine=python_runner_with_seed; phil_layout=circular_naive; assurance_chain=fuzz_pass_rate; counter_example_trace=stuck_run_seed_only";
      mutations = "M2_Assert_to_Fuzz";
      crossover = "";
      focus = "correctness, scalability";

      candidates {
        candidate F1 { style = "fixed_seeds";       prompt = "シード 0..99 で各 1 秒以内に終わることをチェックする。"; }
        candidate F2 { style = "round_robin_vs_random"; prompt = "ラウンドロビンと乱択スケジューラの両方で試す。"; }
        candidate F3 { style = "shrink_failing_seed";   prompt = "失敗したシードについて step 数を半分ずつ減らし、最小再現を出す。"; }
      }
    }

    stage BoundedModelCheck {
      order = 4;
      branch = "main";
      parents = "RandomFuzzWinner";
      archive = "BoundedModelCheckWinner";
      genome = "verification_paradigm=bounded_BFS_state_search; coverage_method=exhaustive_within_depth_bound; property_language=LTL_lite; engine=python_aipl_modelcheck; phil_layout=circular_naive; assurance_chain=BFS_within_depth; counter_example_trace=per_step_world_snapshot";
      mutations = "M3_Fuzz_to_Bounded, M8_Add_LTL_Property, M9_Add_Counter_Example_Trace";
      crossover = "";
      focus = "correctness, counter_example_readability, scalability";

      candidates {
        candidate B1 { style = "depth_only_invariant_check"; prompt = "depth=1000 で is_terminal をデッドロックとして検出する。"; }
        candidate B2 { style = "ltl_safety_progress_pair";   prompt = "G ¬all_hungry_holding_lo と F all_done を両方検査する。"; }
        candidate B3 { style = "trace_with_visited_set";     prompt = "visited set でメモリを抑えつつ反例トレースを保存する。"; }
      }
    }

    stage PromelaSPIN {
      order = 5;
      branch = "exhaustive_external_path";
      parents = "BoundedModelCheckWinner";
      archive = "PromelaSPINWinner";
      genome = "verification_paradigm=SPIN_Promela_exhaustive; engine=external_compiled_pan; channel_model=bounded_chan_capacity; property_language=LTL_in_pml; phil_layout=circular_naive_for_naive_check; assurance_chain=spin_a_then_pan_a; counter_example_trace=spin_t_p_replay";
      mutations = "M4_Bounded_to_Promela, M8_Add_LTL_Property";
      crossover = "";
      focus = "correctness, executability, scalability";

      candidates {
        candidate SP1 { style = "minimal_qsize";          prompt = "QSIZE=8 で 5 哲学者 naive のデッドロックを 132 状態で検出する。"; }
        candidate SP2 { style = "fairness_off_default";   prompt = "弱公平性を切って素直なデッドロック検出に絞る。"; }
        candidate SP3 { style = "trail_replay_in_wrapper"; prompt = "aipl_spin.sh が trail を spin -t -p で再生する。"; }
      }
    }

    stage TLAPlusTLC {
      order = 5;
      branch = "exhaustive_external_path";
      parents = "BoundedModelCheckWinner";
      archive = "TLAPlusTLCWinner";
      genome = "verification_paradigm=TLA_TLC_declarative; engine=external_TLC; action_style=action_predicate_with_primes; mailbox_model=Sequences_with_Append_Tail; property_language=INVARIANT_NoDeadlock; phil_layout=circular_naive_for_naive_check; assurance_chain=tlc_with_check_deadlock_false; counter_example_trace=TLC_error_trace";
      mutations = "M5_Bounded_to_TLA, M8_Add_LTL_Property";
      crossover = "";
      focus = "correctness, type_safety, scalability";

      candidates {
        candidate TL1 { style = "per_class_actions_dispatch"; prompt = "各 method を action 述語として出し、StepActor で dispatch する。"; }
        candidate TL2 { style = "left_biased_at_at_init";     prompt = "@@ の左バイアスに合わせて、初期 send を左、デフォルトを右に置く。"; }
        candidate TL3 { style = "check_deadlock_false_cfg";   prompt = "自然停止と真のデッドロックを区別するため CHECK_DEADLOCK FALSE を付ける。"; }
      }
    }

    stage OrderedAcquisition {
      order = 6;
      branch = "structural_fix_path";
      parents = "BoundedModelCheckWinner";
      archive = "OrderedAcquisitionWinner";
      genome = "verification_paradigm=structural_prevention; fix_kind=ordered_resource_acquisition; phil_layout=ordered_lo_then_hi; engine=python_aipl_modelcheck; assurance_chain=BFS_passes_after_fix; counter_example_trace=none_after_fix";
      mutations = "M6_Symptom_to_Resource_Hierarchy";
      crossover = "C2_Bounded_to_OrderedFix_via_CounterExample";
      focus = "correctness, paradigm_fit, evolvability";

      candidates {
        candidate OA1 { style = "swap_last_phil_lo_hi";       prompt = "最後の phil だけ (lo, hi) を入れ替えて lo < hi を全員に保たせる。"; }
        candidate OA2 { style = "compute_lo_hi_from_min_max"; prompt = "phil の引数 a,b から min/max を取り、lo=min, hi=max にする。"; }
        candidate OA3 { style = "comment_explains_why";       prompt = "Why-comment で「全員が lo<hi だと循環待ちが起きない」を残す。"; }
      }
    }

    stage TypedLinear {
      order = 7;
      branch = "structural_fix_path";
      parents = "OrderedAcquisitionWinner, BoundedModelCheckWinner";
      archive = "TypedLinearWinner";
      genome = "verification_paradigm=typed_static_prevention; channel_kind=linear_owned_channel; ownership=by_type_system; fork_id_order=phantom_type; engine=AIPL_phase_11_to_15_type_checker; assurance_chain=type_check_only; counter_example_trace=type_error_message";
      mutations = "M7_Untyped_to_Linear_Channel";
      crossover = "C3_OrderedConvention_to_TypedLinear";
      focus = "type_safety, paradigm_fit, evolvability";

      candidates {
        candidate TY1 { style = "linear_fork_token";       prompt = "Fork を線形トークンとして渡し、同時 2 重保持を型エラーにする。"; }
        candidate TY2 { style = "phantom_lo_lt_hi";        prompt = "fork id の半順序を phantom 型として持ち、lo より大きい id でしか hi に行けないようにする。"; }
        candidate TY3 { style = "owned_channel_per_phil";  prompt = "各 phil が自分の fork ペアを所有するチャネルとして表し、shared mailbox を排除する。"; }
      }
    }

    stage ProvenAndChecked {
      order = 8;
      branch = "join";
      parents = "TypedLinearWinner, PromelaSPINWinner, TLAPlusTLCWinner";
      archive = "ProvenAndCheckedWinner";
      genome = "verification_paradigm=typed_plus_externally_checked; assurance_chain=type_check_then_SPIN_then_TLC; engine=AIPL_typecheck_plus_aipl_to_promela_plus_aipl_to_tla; phil_layout=ordered_lo_then_hi_typed; counter_example_trace=none_at_any_layer";
      mutations = "M10_Combine_Typed_and_Checked";
      crossover = "C1_SPIN_TLA_to_BackendAbstraction";
      focus = "correctness, type_safety, scalability, evolvability";

      candidates {
        candidate PC1 { style = "type_first_then_export";       prompt = "まず Phase 11–15 で型検査し、通った版だけを SPIN と TLA+ に流す。"; }
        candidate PC2 { style = "single_command_make_target";   prompt = "make verify が型検査・SPIN・TLA+ を順に走らせ、すべて 0 違反で成功とする。"; }
        candidate PC3 { style = "shared_backend_abstraction";   prompt = "aipl_to_promela と aipl_to_tla を共通 backend trait の下に置き、同じ AIPL から両方を出す。"; }
      }
    }
  }
}
