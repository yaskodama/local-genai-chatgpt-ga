aice LocalGenAIScaledEvolutionJP {

  // ===================================================================
  // 続編. LocalGenAIEvolutionJP.aice の Stage 1-2 を継承し、
  // コーパスサイズと params を *対* で進化させる. 直前 .aice の問題:
  //   tiny_corpus.txt が 9.5KB しかなく、 Stage 3 (1M params) を実機
  //   学習すると過学習で停滞 (10 byte / param 未満は丸暗記で頭打ち).
  // 本 .aice は corpus_size_class を独立軸として明示し、 各世代で
  // (corpus, params) の比 を 50-200 byte/param に保つことで、 実機学習
  // が意味のある holdout ppl 改善を生むよう設計する.
  //
  // 評価コーパス階段 (すべて公知・SHA-256 ロック・ローカル):
  //   10KB:    local-genai/corpus/tiny_corpus.txt        (本リポジトリ)
  //   100KB:   tinyshakespeare-100KB.txt                  (PG2700 / Karpathy データ)
  //   500KB:   tinyshakespeare-500KB.txt                  (同上 拡大)
  //   1.1MB:   tinyshakespeare-full.txt                   (Karpathy 公開版)
  // 取得 URL や hash は manifest.json に書く. 本 .aice では size_class のみ.
  //
  // 共通評価プロトコル (継承 + 追加):
  //   metric    = byte-level perplexity on holdout 5%
  //   seed      = 42 固定
  //   deps      = python>=3.11, pytorch==2.x, numpy
  //   compute   = M2 MacBook (CPU/MPS), 30 min/candidate
  //   API       = ローカル LLM (Ollama gemma2:2b 等) 経由のみ可、 外部 API 不可
  //   data/param = 50-200 byte/param 必須 (下回ると 'overfit_warning' 違反)
  // ===================================================================

  dialect = "aice_evolution_v1";

  task = "ローカル MacBook (M2, MPS) で動く byte 単位生成 AI を、 (corpus_size, param_class) を 対 として進化させる. 直前世代 (Stage 2 LSTM, 9.5KB, 198K params, ppl 4.48) を出発点にし、 コーパスを 10KB → 100KB → 500KB → 1MB と段階拡大しながら、 同じスケールで params を 200K → 700K → 2M → 5M へ伸ばす. 各世代で 'data_per_param が 50-200 byte/param 内' を必須条件とする. 終端は SemiAutoEvolveLocalLLM: ローカル LLM (Ollama 等) が次の mutation 候補を 3 案起草し、 人間が 1 案選ぶ半自動ループ. 全段階で実機学習は M2 MPS 30 分以内に終わらなければならない.";

  runtime {
    engine = "ocaml_abcl_cplus";
    executable = "dune exec ./src/repl_thread.exe";
  }

  archive {
    path = "aice-z-evolution/out/evolution/local_genai_scaled_jp/";
    final = "SemiAutoEvolveLocalLLMWinner";
  }

  policy {
    candidate_count = 3;
    reviewer_count = 3;
    selector_output = "1|2|3";
    language_mode = "natural_text_passthrough";
    formal_check = "external";
  }

  actors {
    generator = "候補生成器";
    designer  = "設計推定器";
    trainer   = "学習器";
    reviewer_quality = "言語品質レビュアー";
    reviewer_efficiency = "効率レビュアー";
    reviewer_reproducibility = "再現性レビュアー";
    selector = "選択器";
    archive = "アーカイブ";
  }

  reviewers {
    reviewer QualityReviewer {
      persona = "あなたは言語品質レビュアーです. 候補ジェノムから (corpus_size, params) ペアを確認し、 holdout ppl 期待値が data_per_param 比に整合しているかを見ます. data_per_param < 50 は overfit_warning. 採点は 4 軸 [holdout_ppl が世代の expected レンジ内か / 学習 loss 推移の合理性 / 退化モード耐性 / data_per_param が健全] それぞれ 0-3 点、 計 0-12 点. 期待 ppl レンジ (実測ベース) は (10KB,100K=4.0-5.5), (100KB,500K=2.8-3.5), (500KB,2M=2.2-2.8), (1MB,5M=1.9-2.4). 最後に最良候補番号を 1 行で返します.";
      focus = "holdout_ppl_in_class_range, loss_trajectory, degeneracy, data_per_param_health";
    }
    reviewer EfficiencyReviewer {
      persona = "あなたは効率レビュアーです. data_per_param 比 (50-200 byte/param) と train_time_estimate (M2 MPS 30 分以内) を最重視します. 採点は 4 軸 [data_per_param 比が 50-200 範囲 / params が世代上限内 / train_time<=30min / 推論最適化 (KV キャッシュ等)] それぞれ 0-3 点、 計 0-12 点. 世代上限は (Stage1-2: 200K, Stage3: 500K, Stage4: 1M, Stage5: 3M, Stage6: 6M, Stage7: 6M). 最後に最良候補番号を 1 行で返します.";
      focus = "data_per_param_ratio, param_budget, train_time, inference_throughput";
    }
    reviewer ReproducibilityReviewer {
      persona = "あなたは再現性レビュアーです. 採点は 6 軸 [seed 固定 / corpus が SHA-256 ロック / corpus が公知ソース / 外部 API 不使用 / 依存最小 / 単一スクリプト + checkpoint 保存] それぞれ 0-2 点、 計 0-12 点 (本世代は項目を 1 つ増やす). ローカル LLM 利用は外部 API ではないので減点しない. 最後に最良候補番号を 1 行で返します.";
      focus = "seedable, corpus_pinned, public_source, no_remote_api, minimal_deps, single_script_plus_checkpoint";
    }
  }

  fitness {
    expected_holdout_ppl = 0.30;
    data_per_param_health = 0.20;
    train_time_budget = 0.10;
    inference_efficiency = 0.05;
    reproducibility = 0.20;
    self_evolution_capability = 0.10;
    evolvability = 0.05;
  }

  mutations {

    mutation M1_Scale_Corpus_10x {
      kind = "data_scaling_mutation";
      changes = "corpus_size_class: prev -> next_step_in_{10KB,100KB,500KB,1MB}; data_per_param: rebalance_to_50_to_200_byte_per_param";
      expected_delta = "holdout_ppl: -1.0 ~ -2.0 (corpus 拡大の素直な改善); train_time: x2 ~ x4 (steps 増分); over_budget_risk: 0";
      reason = "params を変えずコーパスだけ拡大する純粋なデータスケール変異. 前世代モデルが overfit 気味なら最大の効果が見える.";
    }

    mutation M2_Add_Transformer_Block {
      kind = "architecture_scaling_mutation";
      changes = "model_family: char_rnn or single_block_transformer -> multi_block_transformer; depth: 1 -> 4; params: x3 ~ x10";
      expected_delta = "holdout_ppl: -0.5 ~ -1.0; train_time: x2 ~ x3; data_per_param: 注意深く維持";
      reason = "コーパスを十分大きくしてから depth を増やす. 9.5KB で 1M params をやると丸暗記したが、 100KB では正味の品質改善が出る.";
    }

    mutation M3_Add_Dropout_For_Generalization {
      kind = "regularization_mutation";
      changes = "regularization: none -> dropout_010";
      expected_delta = "train_ppl: +0.2 ~ +0.5; holdout_ppl: -0.2 ~ -0.4 (改善); data_per_param < 100 の世代でのみ意味";
      reason = "data_per_param が 100 を切る世代では汎化のために必須. 100 以上では不要 (むしろ収束遅延).";
    }

    mutation M4_RoPE_Plus_RMSNorm {
      kind = "modern_transformer_mutation";
      changes = "positional: learned_absolute -> rope; normalization: layernorm -> rmsnorm";
      expected_delta = "holdout_ppl: -0.1 ~ -0.3; params: -0.5%; long_context_quality: +1.0";
      reason = "Llama 系で標準化された 2 工夫. params をほぼ変えずに品質を底上げ. ctx を伸ばす次世代の前提条件.";
    }

    mutation M5_Add_KVCache_Inference {
      kind = "inference_optimization_mutation";
      changes = "inference_optimization: full_recompute -> kv_cache; train: 不変";
      expected_delta = "train: 0 影響; inference_throughput: x4 (ctx=256 時)";
      reason = "学習レシピを変えずに推論だけ高速化. chat REPL の体感速度に直結.";
    }

    mutation M6_Distill_From_Teacher {
      kind = "knowledge_compression_mutation";
      changes = "training_paradigm: maximum_likelihood -> hard_label + soft_label_distillation; teacher: 前世代 archive winner";
      expected_delta = "params: -50%; holdout_ppl: ±0 (生徒が教師に追いつく); train_time: +20%";
      reason = "BigTransformer1MB が学習できたら、 同じ品質を半分の params で達成できるかを試す. ローカル推論の負担を半減.";
    }

    mutation M7_Local_LLM_Proposes_Mutations {
      kind = "meta_evolution_mutation";
      changes = "self_evolution: none -> local_llm_proposes_3_mutations; loop_role: human_writes_aice -> local_llm_drafts_aice_human_picks_one";
      expected_delta = "human_loop_time: -70%; novelty_score: +1.0; regression_risk: +0.5";
      reason = "Ollama 経由で gemma2:2b や qwen2:1.5b にこれまでの aice 全文 + 各世代の reviewer 累積点を渡し、 次の mutation 3 案を mutation ブロック形式で起草させる. 完全ローカル. 既存 mutation との名前重複は禁止. 人間は採否のみ.";
    }
  }

  crossovers {
    crossover C1_Distill_From_BigTransformer {
      parents = "BigTransformer1MBWinner, MidTransformer100KBWinner";
      child = "DistilledMid1MBSeed";
      kind = "compression_crossover";
      combine = "take BigTransformer1MBWinner.weights_as_teacher; take MidTransformer100KBWinner.compact_recipe; replace training_paradigm with hard_plus_soft_distillation";
      expected_delta = "params: 5M -> 2.5M; holdout_ppl: -0.1 ~ +0.2; inference_throughput: +60%";
      reason = "1MB データで 5M params の教師を作ったら、 同じデータで 2.5M params の生徒に蒸留する. 推論コストが半減してローカル体感が良くなる.";
    }
    crossover C2_LLMProposal_Plus_Reviewer_History {
      parents = "DistilledMid1MBWinner, SemiAutoEvolveLocalLLMSeed";
      child = "SemiAutoEvolveLocalLLMWinnerSeed";
      kind = "meta_loop_crossover";
      combine = "take DistilledMid1MBWinner.compact_inference; take SemiAutoEvolveLocalLLMSeed.local_llm_proposal_protocol; add full_aice_history_plus_reviewer_scores_as_context";
      expected_delta = "self_proposal_acceptance_rate: 0.33 -> 0.6; novelty: +0.5; ローカル LLM 推論コスト: ~5s/proposal";
      reason = "ローカル LLM の提案精度を、 過去の reviewer 採点履歴を渡して向上させる. 提案された mutation のうち実機学習 dry-run で overfit_warning を出さないものだけを 3 案として残す.";
    }
  }

  stages {

    // === Stage 1, 2 は既に LocalGenAIEvolutionJP.aice で実機完了 ===
    // local-genai/out/charrnn_winner.pt  (R2 LSTM, ppl 4.48, 198K params, 10KB corpus)

    stage TinyBigram10KB_Inherited {
      order = 1;
      branch = "main";
      parents = "";
      archive = "TinyBigram10KBWinner";
      genome = "model_family=ngram_count; n=2; alpha=1.0; param_class=32K; corpus_size_class=10KB; data_per_param=27.0; engine=stdlib_only; expected_holdout_ppl=15.5; status=already_real_trained_in_LocalGenAIEvolutionJP";
      mutations = "";
      crossover = "";
      focus = "reproducibility, baseline_anchor";

      candidates {
        candidate B1 { style = "char_bigram_laplace_existing"; prompt = "[B1] 既存の N1 を継承. 訓練済 counts は再計算可能. 9.5KB / 357 entries = data_per_param 27 byte/entry."; }
        candidate B2 { style = "char_bigram_laplace_alpha05"; prompt = "[B2] alpha=1.0 を 0.5 にして smoothing を弱める. 期待 ppl 16-17 (hold out にレアな bigram があるとペナルティ)."; }
        candidate B3 { style = "char_bigram_kneser_ney"; prompt = "[B3] Kneser-Ney 風の discount + interpolation. 期待 ppl 14-15.5. stdlib のみで 50 行以内."; }
      }
    }

    stage TinyCharRNN10KB_Inherited {
      order = 2;
      branch = "main";
      parents = "TinyBigram10KBWinner";
      archive = "TinyCharRNN10KBWinner";
      genome = "model_family=char_rnn; cell=LSTM; embed_dim=128; hidden_dim=128; tied=false; dropout=0; param_class=200K; corpus_size_class=10KB; data_per_param=0.05_byte_per_param; engine=pytorch_cpu; expected_holdout_ppl=4.5; status=already_real_trained_R2_winner; checkpoint=local-genai/out/charrnn_winner.pt; warning=overfit_data_per_param_below_50";
      mutations = "M1_NGram_to_CharRNN inherited";
      crossover = "";
      focus = "expected_holdout_ppl, baseline_for_scaling";

      candidates {
        candidate C1 { style = "lstm_untied_existing_winner"; prompt = "[C1] 既存 R2 を継承. 学習済 checkpoint あり. ppl 4.48. 注: data_per_param=0.05 は厳しい overfit 領域. 次世代でコーパス拡大が必須."; }
      }
    }

    // === ここから新規 ===

    stage MidCharRNN100KB {
      order = 3;
      branch = "main";
      parents = "TinyCharRNN10KBWinner";
      archive = "MidCharRNN100KBWinner";
      genome = "model_family=char_rnn; cell=LSTM; embed_dim=128; hidden_dim=128; tied=false; dropout=0.05; param_class=200K; corpus_size_class=100KB; data_per_param=0.5_byte_per_param; engine=pytorch_cpu_or_mps; expected_holdout_ppl=3.5-4.0; expected_train_time_min=10";
      mutations = "M1_Scale_Corpus_10x";
      crossover = "";
      focus = "expected_holdout_ppl, data_per_param_health";

      candidates {
        candidate M1A { style = "same_lstm_more_data"; prompt = "[M1A same_lstm_more_data] arch: 既存 R2 LSTM そのまま (hidden=128, untied). corpus: tinyshakespeare 最初 100KB (PG2700 由来 / SHA-256 ロック). レシピ: AdamW(lr=2e-3, wd=0.01), batch=64, BPTT=128, steps=4000, warmup=200, MPS, dropout=0.05. 期待: params=198K 不変, ppl=3.7, train=12 min. データ 10x で過学習が緩和され ppl 4.5 -> 3.7 を狙う."; }
        candidate M1B { style = "lstm_with_dropout_010"; prompt = "[M1B lstm_with_dropout_010] M1A と同じだが dropout=0.10 に上げる. 期待: train_ppl 上昇 +0.5, holdout_ppl=3.6 (汎化向上). 100KB データではまだ dropout が効く."; }
        candidate M1C { style = "smaller_lstm_hidden_96"; prompt = "[M1C smaller_lstm_hidden_96] arch: hidden=96 に縮小. params=130K, data_per_param=0.77 byte/param へ改善. 期待: ppl=3.9 (微悪化) だが効率レビュアーが評価."; }
      }
    }

    stage MidTransformer100KB {
      order = 4;
      branch = "main";
      parents = "MidCharRNN100KBWinner";
      archive = "MidTransformer100KBWinner";
      genome = "model_family=multi_block_transformer; depth=4; n_heads=4; d_model=128; ffn_mult=4; vocab=256; ctx=128; positional=rope; normalization=rmsnorm; tied=true; dropout=0.05; param_class=500K; corpus_size_class=100KB; data_per_param=0.20_byte_per_param; engine=pytorch_mps; expected_holdout_ppl=2.9-3.4; expected_train_time_min=15";
      mutations = "M2_Add_Transformer_Block, M3_Add_Dropout_For_Generalization, M4_RoPE_Plus_RMSNorm, M5_Add_KVCache_Inference";
      crossover = "";
      focus = "expected_holdout_ppl, parameter_efficiency, inference_efficiency";

      candidates {
        candidate T4A { style = "depth4_h4_d128_rope_rmsnorm_drop005"; prompt = "[T4A] arch: depth=4, n_heads=4, d_model=128, ffn_mult=4, RoPE, RMSNorm, tied, dropout=0.05, KV cache. params ≒ 2*256*128 + 4*(4*128^2 + 2*128*4*128) ≒ 100K + 525K - 32K(tied) ≒ 593K. レシピ: AdamW(lr=3e-4 -> cosine 3e-5), batch=32, ctx=128, steps=4000, warmup=400, MPS. 期待: ppl=3.0, train=14 min, infer x4 KV. 出力: tx_train.py + tx_chat.py."; }
        candidate T4B { style = "depth6_h4_d96_thinner"; prompt = "[T4B] depth=6 にしつつ d_model=96 で params を 530K に抑える. data_per_param=0.19. 期待: ppl=3.1 (深さで稼ぐ), train=16 min."; }
        candidate T4C { style = "depth4_h8_d96_more_heads"; prompt = "[T4C] n_heads=8 (head_dim=12) で頭ごと専門化. d_model=96, params=350K. data_per_param=0.29. 期待: ppl=3.2, train=12 min, 効率が高い."; }
      }
    }

    stage BigTransformer1MB {
      order = 5;
      branch = "scale_path";
      parents = "MidTransformer100KBWinner";
      archive = "BigTransformer1MBWinner";
      genome = "model_family=multi_block_transformer; depth=6; n_heads=8; d_model=192; ffn_mult=4; vocab=256; ctx=256; positional=rope; normalization=rmsnorm; tied=true; dropout=0.05; param_class=3M; corpus_size_class=1MB; data_per_param=0.30_byte_per_param; engine=pytorch_mps; expected_holdout_ppl=2.0-2.4; expected_train_time_min=25";
      mutations = "M1_Scale_Corpus_10x, M2_Add_Transformer_Block";
      crossover = "";
      focus = "expected_holdout_ppl, parameter_efficiency, train_time_budget";

      candidates {
        candidate B5A { style = "depth6_h8_d192_ctx256"; prompt = "[B5A] arch: depth=6, n_heads=8 (head_dim=24), d_model=192, ffn_mult=4, RoPE, RMSNorm, tied, dropout=0.05, KV cache, ctx=256. params ≒ 2*256*192 + 6*(4*192^2 + 2*192*4*192) - 49K(tied) ≒ 3.4M. corpus=tinyshakespeare 1.1MB full. レシピ: AdamW(lr=3e-4 cosine 3e-5), batch=32, ctx=256, steps=8000, warmup=800, MPS, bf16. 期待: ppl=2.2, train=24 min, infer x5 KV. data_per_param=0.32."; }
        candidate B5B { style = "depth8_h4_d160_thinner"; prompt = "[B5B] depth=8, d_model=160. params=2.7M, data_per_param=0.41. 期待: ppl=2.3 (深さで稼ぐ), train=27 min."; }
        candidate B5C { style = "depth4_h8_d256_wider"; prompt = "[B5C] depth=4, d_model=256. params=3.2M, data_per_param=0.34. wide-shallow. 期待: ppl=2.4, train=22 min, 推論は遅め."; }
      }
    }

    stage DistilledMid1MB {
      order = 6;
      branch = "scale_path";
      parents = "BigTransformer1MBWinner, MidTransformer100KBWinner";
      archive = "DistilledMid1MBWinner";
      genome = "model_family=multi_block_transformer_compact; depth=4; n_heads=4; d_model=160; ffn_mult=4; vocab=256; ctx=256; positional=rope; normalization=rmsnorm; tied=true; dropout=0.05; param_class=2M; corpus_size_class=1MB; data_per_param=0.55_byte_per_param; engine=pytorch_mps; teacher=BigTransformer1MBWinner; distill_temperature=2.0; loss_mix=alpha=0.5; expected_holdout_ppl=2.2-2.5; expected_train_time_min=20";
      mutations = "M6_Distill_From_Teacher, M5_Add_KVCache_Inference";
      crossover = "C1_Distill_From_BigTransformer";
      focus = "expected_holdout_ppl, parameter_efficiency, inference_efficiency";

      candidates {
        candidate D6A { style = "soft_label_T2_alpha05"; prompt = "[D6A] arch: depth=4, h=4, d=160 の 2M-param 生徒. 教師=BigTransformer1MB winner (state dict をロード). T=2.0, alpha=0.5, AdamW lr=3e-4, batch=32, steps=4500, MPS. 期待: ppl=2.3 (教師にほぼ追いつく), train=18 min. inference_throughput は教師比 x1.7 (params 2/3)."; }
        candidate D6B { style = "intermediate_layer_match"; prompt = "[D6B] D6A + 各層の hidden state MSE を加える (FitNets 風). beta=0.2. 教師と生徒の depth が一致 (4=4) なので層対応可. 期待: ppl=2.25, train=21 min."; }
        candidate D6C { style = "data_only_distill_no_logits"; prompt = "[D6C] 教師に追加で 1MB 生成させ、 生徒は素直に CE 学習. logits は使わない. 期待: ppl=2.4 (D6A より 0.1 悪い), train=18 min + 教師生成 5 min. 単純さ."; }
      }
    }

    stage SemiAutoEvolveLocalLLM {
      order = 7;
      branch = "join";
      parents = "DistilledMid1MBWinner, BigTransformer1MBWinner";
      archive = "SemiAutoEvolveLocalLLMWinner";
      genome = "model_family=multi_block_transformer_compact_self_evolving; depth=4; n_heads=4; d_model=160; ffn_mult=4; param_class=2M; corpus_size_class=1MB; data_per_param=0.55_byte_per_param; engine=pytorch_mps; training_paradigm=continue_distill_with_self_proposed_mutation; self_evolution=local_ollama_proposes_3_mutations; loop_protocol={input=[full_aice_history, mutation_log, reviewer_scores_per_stage, fitness_trajectory, current_archive], output=[3_mutation_blocks_in_aice_format_with_expected_delta], filtering=human_picks_one, regression_guard=next_holdout_ppl_must_not_increase_by_more_than_0.2}; ollama_model_default=gemma2:2b; expected_holdout_ppl=2.1-2.4";
      mutations = "M7_Local_LLM_Proposes_Mutations";
      crossover = "C2_LLMProposal_Plus_Reviewer_History";
      focus = "self_evolution_capability, evolvability, reproducibility";

      candidates {
        candidate SE7A {
          style = "ollama_drafts_three_mutations";
          prompt = "[SE7A] 入力 = [本 .aice 全文, 既存 mutation list, 各世代の 3 reviewer 累積点数, 現 archive の checkpoint metadata]. プロセス: ローカル Ollama (デフォルト gemma2:2b) に system prompt として 'aice mutation block 形式で 3 案を起草. 既存 M1-M7 と名前重複禁止. 各 mutation に kind/changes/expected_delta/reason を 1 行ずつ. 提案後、 dry-run estimator で overfit_warning が出る案は自動除外して残りを human に提示.' 出力 = mutation ブロック x3. 人間は 1 案を選んで .aice に追記.";
        }
        candidate SE7B {
          style = "ollama_writes_full_next_stage";
          prompt = "[SE7B] SE7A をさらに進めて、 mutation だけでなく次の stage 全体 (genome + 3 candidates + 期待 fitness + 親 archive) を 1 つ起草する. regression_guard: dry-run で次世代 holdout_ppl が現 archive より 0.2 以上悪化する設計は自動拒否. リスクは aice 編集規模, 利点は 1 案=次世代まるごと.";
        }
        candidate SE7C {
          style = "ollama_critiques_then_proposes";
          prompt = "[SE7C] 前世代 (DistilledMid1MB) の最良候補の弱点を Ollama に 3 行で自己批評させ、 その弱点だけを埋める変異を 3 案提案する. 多様性は減るが提案精度は上がる. 過去 reviewer 採点で伸び悩んだ軸 (例: data_per_param_health) を狙い撃ちにできる.";
        }
      }
    }
  }
}
