// Multi-dimensional arrays + dynamic sizes (AIPL).
//
// Syntax extensions in this demo:
//   var grid[R][C];          — 2D array, default 0, R rows × C cols
//   var grid[R][C] = -1;     — same but all cells initialized to -1
//   var x[n];                — single-dim with dynamic size n
//   var cube[a][b][c];       — 3D, any number of dimensions
//   m[i][j]                  — read with multiple indices
//   m[i][j] = v;             — write with multiple indices
//
// Sizes in [...] can be any expression — variables, fields, params,
// arithmetic. They're evaluated at the point of declaration.

class Matrix {
  // 2-D field with dynamic size carried by other fields.
  var rows = 4;
  var cols = 5;
  var cells[rows][cols];          // 4×5 grid, all 0

  method fill_with_sum() {
    var i = 0;
    while (i < rows) do {
      var j = 0;
      while (j < cols) do {
        cells[i][j] = i + j;       // index-assign on 2D
        j = j + 1;
      }
      i = i + 1;
    }
  }

  method print_grid() {
    print("Matrix " + rows + "x" + cols + ":");
    var i = 0;
    while (i < rows) do {
      var line = "  ";
      var j = 0;
      while (j < cols) do {
        line = line + cells[i][j] + " ";  // index-read on 2D
        j = j + 1;
      }
      print(line);
      i = i + 1;
    }
  }

  method trace() {
    // sum of diagonal — works for square or rectangular.
    var i = 0;
    var t = 0;
    var lim = rows;
    if (cols < rows) { lim = cols; }
    while (i < lim) do {
      t = t + cells[i][i];
      i = i + 1;
    }
    reply(t);
  }
}

class Cube {
  // 3-D field.
  var values[2][3][4] = -1;

  method poke(i, j, k, v) {
    values[i][j][k] = v;
  }

  method peek(i, j, k) {
    reply(values[i][j][k]);
  }

  method dump() {
    print("Cube 2x3x4:");
    var i = 0;
    while (i < 2) do {
      var j = 0;
      while (j < 3) do {
        var line = "  layer " + i + " row " + j + ":";
        var k = 0;
        while (k < 4) do {
          line = line + " " + values[i][j][k];
          k = k + 1;
        }
        print(line);
        j = j + 1;
      }
      i = i + 1;
    }
  }
}

class Demo {
  method run() {
    print("=== AIPL multi-dim + dynamic-size arrays ===");

    // 1) Local 2-D matrix with dynamic sizes from variables.
    var R = 3;
    var C = 6;
    var pad[R][C] = 7;
    print("Pad " + R + "x" + C + " (default 7), then set diagonal to row*10:");
    var d = 0;
    while (d < 3) do {
      pad[d][d] = d * 10;
      d = d + 1;
    }
    var i = 0;
    while (i < R) do {
      var line = "  ";
      var j = 0;
      while (j < C) do {
        line = line + pad[i][j] + " ";
        j = j + 1;
      }
      print(line);
      i = i + 1;
    }

    // 2) Dynamic single-dim using an expression for the size.
    var n = 4 + 1;             // 5
    var sieve[n] = 1;
    sieve[0] = 0;
    sieve[1] = 0;
    print("Sieve of length " + n + ":");
    var p = 0;
    while (p < n) do {
      print("  sieve[" + p + "] = " + sieve[p]);
      p = p + 1;
    }

    // 3) Field-level 2D matrix on Matrix actor.
    var m = new Matrix();
    send m.fill_with_sum();
    send m.print_grid();
    var t = now m.trace();
    print("trace = " + t);

    // 4) Field-level 3D cube on Cube actor.
    var c = new Cube();
    send c.poke(0, 0, 0, 100);
    send c.poke(1, 2, 3, 999);
    send c.poke(0, 2, 1, 42);
    var v = now c.peek(1, 2, 3);
    print("cube[1][2][3] = " + v);
    send c.dump();
  }
}

var d = new Demo();
send d.run();
