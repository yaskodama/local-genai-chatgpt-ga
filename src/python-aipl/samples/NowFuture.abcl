// Demo of all three message-passing types in ABCL/c+:
//   past:   send target.method(args);                    // fire-and-forget
//   now:    var x = now target.method(args);             // blocks until reply
//   future: var f = future target.method(args);          // returns Future
//           var v = await(f);                            //   ... await later
//
// The callee uses reply(value) to deliver the result back to the
// caller's future.  In a past-type send there is no future, so reply()
// just logs [REPLY] for visibility.
class Calculator {
  method add(a, b) {
    reply(a + b);
  }
  method slow_double(x) {
    call wait(80);          // pretend this is expensive work
    reply(x * 2);
  }
}

class Driver {
  var calc = 0;

  method init(c) {
    calc = c;
  }

  method run() {
    // past — no reply value here, just logged
    send calc.add(1, 2);

    // now — synchronous, returns the value
    var s = now calc.add(3, 4);
    print("[now] 3 + 4 = " + s);

    // future — fire two parallel jobs, then await both
    var f1 = future calc.slow_double(10);
    var f2 = future calc.slow_double(20);
    print("[future] both jobs running in parallel");
    var v1 = await(f1);
    var v2 = await(f2);
    print("[future] results: " + v1 + ", " + v2);
  }
}

var calc = new Calculator();
var driver = new Driver(calc);
send driver.run();
