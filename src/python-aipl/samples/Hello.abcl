// Smallest meaningful actor: counts greetings.
// Phase 11+ idiom: typed field, typed init/method params.
class Hello {
  var count: int = 0;

  method init(n: int) {
    count = n;
    print("Hello object initialized with " + n);
  }

  method greet() {
    print("Hello! count = " + count);
  }

  method inc() {
    count = count + 1;
    print("count incremented to " + count);
  }
}

var h = new Hello(5);
send h.greet();
send h.inc();
send h.greet();
