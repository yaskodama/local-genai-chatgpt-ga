// Counter that self-sends to demonstrate `send self.method(...)`.
// Phase 11+: typed field + transient-cast clean.
class Counter {
  var count: int = 0;

  method inc() {
    count = count + 1;
    print("count: " + count);
    if (count < 3) {
      send self.inc();
    }
  }
}

var c = new Counter();
send c.inc();
