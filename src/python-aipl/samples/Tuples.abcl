// Tuple literals (組型) — positional, fixed-arity, immutable.
//
//   ()              — empty tuple
//   (x,)            — 1-tuple (trailing comma required to disambiguate from grouping)
//   (1, 20, "test") — N-tuple, types can differ per slot
//   (2, (3, 4))     — nested tuples
//   t[i]            — positional access (read-only)
//   typeof(t)       — "tuple(int, int, string)" / "tuple(int, tuple(int, int))" / ...
//
// Tuples are distinct from arrays:
//   - arrays:   homogeneous, mutable, dynamic length
//   - tuples:   positional, immutable, length is part of the type

class PointActor {
  // Field-level tuple — coordinates as (x, y).
  var origin = (0, 0);
  var meta = ("city", 100, 35.6);   // (label, population_k, latitude)

  method translate(p, dx, dy) {
    // Tuples are immutable; build a new one.
    reply((p[0] + dx, p[1] + dy));
  }

  method describe() {
    print("origin = (" + origin[0] + ", " + origin[1] + ")");
    print("meta   = (" + meta[0] + ", " + meta[1] + ", " + meta[2] + ")");
    print("typeof(origin) = " + typeof(origin));
    print("typeof(meta)   = " + typeof(meta));
  }
}

class Demo {
  method run() {
    print("=== AIPL tuple literals (組型) ===");

    // 1) Heterogeneous tuple from the request.
    var t1 = (1, 20, "test");
    print("t1     = (" + t1[0] + ", " + t1[1] + ", " + t1[2] + ")");
    print("typeof(t1) = " + typeof(t1));

    // 2) Nested tuple from the request.
    var t2 = (2, (3, 4));
    print("t2[0]      = " + t2[0]);
    print("t2[1][0]   = " + t2[1][0]);
    print("t2[1][1]   = " + t2[1][1]);
    print("typeof(t2) = " + typeof(t2));

    // 3) Empty and 1-tuple.
    var empty = ();
    var single = (42,);
    print("typeof(empty)  = " + typeof(empty));
    print("typeof(single) = " + typeof(single));
    print("single[0] = " + single[0]);

    // 4) Tuple inside a record, record inside a tuple.
    var pair = ({ name: "Alice", age: 30 }, [1, 2, 3]);
    var rec = pair[0];                  // extract via temp (chained postfix not yet supported)
    var arr = pair[1];
    print("pair[0].name = " + rec.name);
    print("pair[1][2]   = " + arr[2]);
    print("typeof(pair) = " + typeof(pair));

    // 5) Length via array_len works on tuples too.
    print("array_len(t1) = " + array_len(t1));
    print("array_len(t2) = " + array_len(t2));

    // 6) Use field-level tuples in an actor.
    var p = new PointActor();
    var moved = now p.translate((3, 4), 10, -1);
    print("moved = (" + moved[0] + ", " + moved[1] + ")");
    print("typeof(moved) = " + typeof(moved));
    send p.describe();
  }
}

var d = new Demo();
send d.run();
