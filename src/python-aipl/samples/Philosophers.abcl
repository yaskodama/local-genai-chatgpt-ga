// 3-philosophers dining problem.  Forks are actors that hand out
// permission via `granted` / `refused` messages; philosophers eat a
// bounded number of times and then stop, so the program terminates.
//
// Phase 11+ idiom: typed fields + method-param types; `pub` exposes
// `meals` so an external watchdog could read remaining meals without
// needing a method (Phase 15 read access).
class Fork {
  var held: int = 0;

  method request() {
    if (held == 0) {
      held = 1;
      send sender.granted();
    } else {
      send sender.refused();
    }
  }
  method release() {
    held = 0;
  }
}

class Philosopher {
  var id: int = 0;
  var left = 0;          // bound to actor(Fork) in init()
  var right = 0;         // bound to actor(Fork) in init()
  pub var meals: int = 2;
  var got_left: int = 0;

  method init(my_id: int, l, r, n: int) {
    id = my_id;
    left = l;
    right = r;
    meals = n;
    got_left = 0;
    send self.try_left();
  }

  method try_left() {
    if (meals > 0) { send left.request(); }
  }

  method granted() {
    if (got_left == 0) {
      got_left = 1;
      send right.request();
    } else {
      print("[phil " + id + "] eating, meals=" + meals);
      meals = meals - 1;
      got_left = 0;
      send left.release();
      send right.release();
      if (meals > 0) { send self.try_left(); }
      else           { print("[phil " + id + "] done"); }
    }
  }

  method refused() {
    if (got_left == 1) {
      send left.release();
      got_left = 0;
    }
    send self.try_left();
  }
}

var f0 = new Fork();
var f1 = new Fork();
var f2 = new Fork();
// Ordered acquisition: every philosopher requests the lower-id fork
// first, breaking the circular-wait condition.  Without this, three
// philosophers grabbing their "left" simultaneously livelock under our
// refused/retry strategy.
var p0 = new Philosopher(0, f0, f1, 2);
var p1 = new Philosopher(1, f1, f2, 2);
var p2 = new Philosopher(2, f0, f2, 2);
