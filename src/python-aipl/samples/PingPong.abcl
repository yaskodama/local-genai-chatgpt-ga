// Two actors bouncing a bounded number of messages.  We use a counter
// rather than infinite recursion so the smoke test can complete on its
// own without relying on the wall-clock timeout.
//
// Phase 11+ idiom: typed fields and `init` / `bind` params.  `partner`
// is bound to an `actor(Ponger)` reference at runtime via `bind`.
class Pinger {
  var left: int = 5;
  var partner = 0;        // bound to actor(Ponger) via bind()

  method init(n: int) {
    left = n;
  }

  method bind(p) {
    partner = p;
    send partner.ping();
  }

  method pong() {
    print("Pinger got pong, left=" + left);
    left = left - 1;
    if (left > 0) {
      send sender.ping();
    }
  }
}

class Ponger {
  method ping() {
    print("Ponger got ping");
    send sender.pong();
  }
}

var pinger = new Pinger(5);
var ponger = new Ponger();
send pinger.bind(ponger);
