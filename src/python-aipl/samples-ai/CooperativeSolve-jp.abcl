// 3 役のエージェントが協調して問題を解く (日本語版・全部ローカル)。
//
// 各 actor が独立した system プロンプト = 役割を持ち、ai_call は
// それぞれ別の AI 呼び出しになる。Coordinator は `now` で順番に
// 連鎖させ、前段の応答を次段に渡す。
//
// 実行:
//   GEMINI_API_KEY=...  /usr/bin/python3 abcl_main.py \
//     --timeout 180  samples-ai/CooperativeSolve-jp.abcl

class Planner {
  var persona = "あなたは経験豊富なプランナーです。与えられた問題を解くための番号付き手順を、最大3ステップで簡潔に提示してください。番号付きの手順のみを返答し、前置きや余計な説明は一切付けないでください。";

  method plan(problem) {
    var p = ai_call_with_system(persona, problem);
    reply(p);
  }
}

class Solver {
  var persona = "あなたは慎重で正確な解答者です。問題文と手順を受け取ります。手順に従って実行し、具体的な解答 / 修正コード / 最終回答を提示してください。明示的かつ具体的に、前置きはなしで返答してください。";

  method solve(problem_and_plan) {
    var s = ai_call_with_system(persona, problem_and_plan);
    reply(s);
  }
}

class Reviewer {
  var persona = "あなたは厳しいレビュアーです。問題と解答案を見て、2〜3文で次を述べてください: (1) 解答は正しいか? (2) 最も重要な改善点は何か?  前置きはなしで、プレーンテキストで返答してください。";

  method review(problem_and_solution) {
    var r = ai_call_with_system(persona, problem_and_solution);
    reply(r);
  }
}

class Coordinator {
  var planner   = 0;
  var solver    = 0;
  var reviewer  = 0;

  method init() {
    planner  = new Planner();
    solver   = new Solver();
    reviewer = new Reviewer();
  }

  method tackle(problem) {
    print("================== 問題 ==================");
    print(problem);
    print("");

    print("================== 1) プランナー ==================");
    var plan = now planner.plan(problem);
    print(plan);
    print("");

    print("================== 2) ソルバー ==================");
    var ps = "問題:\n" + problem + "\n\n手順:\n" + plan;
    var solution = now solver.solve(ps);
    print(solution);
    print("");

    print("================== 3) レビュアー ==================");
    var psol = "問題:\n" + problem + "\n\n解答案:\n" + solution;
    var critique = now reviewer.review(psol);
    print(critique);
    print("");

    print("================== 使用量 ==================");
    print(ai_usage());
  }
}

// サンプル問題: 階乗のバグ。`+` を `*` に直すだけだが、Reviewer は
// 「負数で無限再帰になる」など追加の改善点に気づくかが見どころ。
var c = new Coordinator();
send c.tackle("次の Python 関数のバグを見つけて修正してください:\n\ndef factorial(n):\n    if n == 0:\n        return 1\n    return n + factorial(n - 1)\n\n回答には (a) バグの説明 と (b) コードブロックで修正後の関数 を含めてください。");
