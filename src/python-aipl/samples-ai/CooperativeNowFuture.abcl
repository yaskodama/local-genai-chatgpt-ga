// 3-role AI cooperation expressed with now / future / await.
// Mirrors the OCaml/JS CooperativeNowFuture sample.
//
// Run:
//   ABCL_AI_PROVIDER=mock /opt/homebrew/bin/python3.13 abcl_main.py \
//     --timeout 60 samples-ai/CooperativeNowFuture.abcl
//   GEMINI_API_KEY=... /opt/homebrew/bin/python3.13 abcl_main.py \
//     --timeout 180 samples-ai/CooperativeNowFuture.abcl

class Planner {
  method plan(q) {
    var sketch = ai_call_with_system(
      "You are a planner. Output a 1-line plan, no preamble.",
      q);
    reply(sketch);
  }
}

class Solver {
  method solve(plan) {
    var ans = ai_call_with_system(
      "You are a solver. Apply the given plan and answer concisely.",
      plan);
    reply(ans);
  }
}

class Reviewer {
  method review(ans) {
    var verdict = ai_call_with_system(
      "You are a reviewer. Reply with 'OK: <reason>' or 'NG: <reason>' only.",
      ans);
    reply(verdict);
  }
  method brief() {
    var b = ai_call("In one short sentence: what does a code reviewer look for?");
    reply(b);
  }
}

class Coordinator {
  var planner  = 0;
  var solver   = 0;
  var reviewer = 0;

  method init() {
    planner  = new Planner();
    solver   = new Solver();
    reviewer = new Reviewer();
  }

  method tackle(q) {
    // 1) planner runs synchronously — solver depends on its output
    var plan = now planner.plan(q);
    print("[plan] " + plan);

    // 2) solver and reviewer.brief run in parallel via `future`
    var fut_ans   = future solver.solve(plan);
    var fut_brief = future reviewer.brief();

    var answer = await(fut_ans);
    print("[answer] " + answer);

    var brief = await(fut_brief);
    print("[reviewer brief] " + brief);

    // 3) final review synchronously, after answer is known
    var verdict = now reviewer.review(answer);
    print("[verdict] " + verdict);
  }
}

var c = new Coordinator();
send c.tackle("What is 12 * 11? Show only the number.");
