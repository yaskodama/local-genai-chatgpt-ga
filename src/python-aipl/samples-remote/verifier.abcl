// Distributed AI: verifier node.
//
// Listens on port 9002.  Receives (question, draft_answer) and
// returns a one-sentence critique judging quality and pointing out
// the most important improvement.  Run on a different machine /
// account / provider than the solver to get a real second opinion.
//
// Run:
//   ANTHROPIC_API_KEY=... /usr/bin/python3 abcl_main.py samples-remote/verifier.abcl
class Verifier {
  method check(q: string, a: string) -> string !{ai, net} {
    print("[verifier] checking answer for: " + q);
    var prompt: string = "Question: " + q + "\n\nDraft answer: " + a + "\n\nCritique in one sentence: is this answer correct and clear?  If not, what's the single most important fix?";
    var v: string = ai_call_with_system(
      "You are a strict reviewer.  Reply in one sentence.  No preamble.",
      prompt
    );
    print("[verifier] verdict=" + v);
    reply(v);
  }
}

var verifier = new Verifier();
web_listen(9002);
print("[node] verifier up on http://localhost:9002 (actor: verifier)");
