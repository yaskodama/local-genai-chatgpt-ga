// ============================================================================
// Distributed dining philosophers — browser side (P0, P1, P2 + fork0, fork1)
//
// Companion program: distributed_philosophers_ocaml.abcl (runs P3, P4 and
// fork2, fork3, fork4 inside the OCaml ABCL REPL on localhost:8080).
//
// Remote-send protocol (browser -> OCaml):
//   The variables fork2 and fork4 hold the handle strings "@fork2" / "@fork4".
//   The browser runtime recognises the leading '@' and dispatches the send
//   over HTTP (POST /api/json/send) instead of the local mailbox. On the
//   OCaml side the gateway delivers it to its in-process `fork2` / `fork4`
//   actor. The reverse direction (OCaml -> browser) is the OCaml program's
//   responsibility (`send remote("localhost:8080","pX")`). The browser's
//   WebSocket listener on sid=bridge receives those forwarded frames and
//   delivers them to the local P0 / P2 mailbox.
// ============================================================================

class Fork {
  var id       = 0;
  var taken    = 0;
  var waiter   = "";
  var waiterId = 0;     // valid only when waiter != "" (browser parser has no unary minus)

  method init(myId) {
    id = myId;
    print("VIZ FORK " + id + " FREE");
  }

  method take(reqId) {
    if (taken == 0) {
      taken = 1;
      call fork_held(id, reqId);
      print("VIZ FORK " + id + " TAKEN " + reqId);
      send sender.fork_granted();
    } else {
      waiter   = sender;
      waiterId = reqId;
    }
  }

  method release() {
    if (waiter == "") {
      taken = 0;
      call fork_free(id);
      print("VIZ FORK " + id + " FREE");
    } else {
      call fork_held(id, waiterId);
      print("VIZ FORK " + id + " HANDOFF " + waiterId);
      print("VIZ FORK " + id + " TAKEN " + waiterId);
      send waiter.fork_granted();
      waiter   = "";
      waiterId = 0;
    }
  }
}

class Philosopher {
  var id       = 0;
  var lowFork  = "";
  var highFork = "";
  var hasLow   = 0;
  var eatCount = 0;
  var running  = 0;

  method init(myId, lo, hi) {
    id       = myId;
    lowFork  = lo;
    highFork = hi;
  }

  method start() {
    // Idempotent: don't clobber the hasLow bookkeeping if we're already in
    // the middle of a dinner cycle, otherwise a retriggered start will leak
    // a fork that we thought we were still holding.
    if (running == 0) {
      running = 1;
      hasLow  = 0;
      send self.think();
    }
  }

  method stop() {
    running = 0;
  }

  method think() {
    if (running == 0) {
      print("VIZ PHILO " + id + " DONE");
    } else {
      call philo_state(id, 0);
      print("VIZ PHILO " + id + " THINK");
      call wait(700);
      send self.hungry();
    }
  }

  method hungry() {
    if (running == 0) {
      print("VIZ PHILO " + id + " DONE");
    } else {
      call philo_state(id, 1);
      print("VIZ PHILO " + id + " HUNGRY");
      hasLow = 0;
      send lowFork.take(id);
    }
  }

  method fork_granted() {
    if (running == 0) {
      send lowFork.release();
      if (hasLow == 1) {
        send highFork.release();
        hasLow = 0;
      }
      print("VIZ PHILO " + id + " DONE");
    } else {
      if (hasLow == 0) {
        hasLow = 1;
        send highFork.take(id);
      } else {
        send self.eat();
      }
    }
  }

  method eat() {
    if (running == 0) {
      send lowFork.release();
      send highFork.release();
      print("VIZ PHILO " + id + " DONE");
    } else {
      call philo_state(id, 2);
      eatCount = eatCount + 1;
      print("VIZ PHILO " + id + " EAT " + eatCount);
      call wait(900);
      send self.eat_done();
    }
  }

  method eat_done() {
    send lowFork.release();
    send highFork.release();
    if (running == 0) {
      print("VIZ PHILO " + id + " DONE");
    } else {
      send self.think();
    }
  }
}

// Local fork actors (browser-side)
var fork0 = new Fork(0);
var fork1 = new Fork(1);

// Resource hierarchy: every philosopher takes the lower-numbered fork first.
// Fork names are passed as string literals. Remote forks use the "@name"
// convention; the bridge runtime (installBridgeSend) recognises the leading
// '@' and forwards the send over HTTP to the OCaml gateway.
var p0 = new Philosopher(0, "fork0", "@fork4");
var p1 = new Philosopher(1, "fork0", "fork1");
var p2 = new Philosopher(2, "fork1", "@fork2");
