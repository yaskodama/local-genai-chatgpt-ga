// CooperativeSolve-jp.abcl と同じ形だが、Reviewer は別マシン
// (例: localhost:9100 の Docker コンテナ) で動いている前提。
// Planner と Solver はホストでローカル実行、Reviewer だけ remote_now で
// リモートに渡す。
//
// 実行手順:
//   1. レビュアーノードを起動 (Docker / 別マシンなど):
//        docker run -d --rm --name abcl-reviewer -p 9100:9100 \
//          -e GEMINI_API_KEY=... \
//          -v /Users/.../python-abcl:/app/python-abcl:ro \
//          abcl-cp:latest /app/python-abcl/samples-remote/reviewer_node_jp.abcl
//   2. ホストで本ファイルを実行:
//        GEMINI_API_KEY=... /usr/bin/python3 abcl_main.py --timeout 180 \
//          samples-ai/CooperativeSolveRemote-jp.abcl

class Planner {
  var persona = "あなたは経験豊富なプランナーです。与えられた問題を解くための番号付き手順を、最大3ステップで簡潔に提示してください。番号付きの手順のみを返答し、前置きや余計な説明は一切付けないでください。";

  method plan(problem) {
    var p = ai_call_with_system(persona, problem);
    reply(p);
  }
}

class Solver {
  var persona = "あなたは慎重で正確な解答者です。問題文と手順を受け取ります。手順に従って実行し、具体的な解答 / 修正コード / 最終回答を提示してください。明示的かつ具体的に、前置きはなしで返答してください。";

  method solve(problem_and_plan) {
    var s = ai_call_with_system(persona, problem_and_plan);
    reply(s);
  }
}

class Coordinator {
  var planner       = 0;
  var solver        = 0;
  var reviewer_addr = "localhost:9100";

  method init() {
    planner = new Planner();
    solver  = new Solver();
  }

  method tackle(problem) {
    print("================== 問題 ==================");
    print(problem);
    print("");

    print("================== 1) プランナー (ホスト) ==================");
    var plan = now planner.plan(problem);
    print(plan);
    print("");

    print("================== 2) ソルバー (ホスト) ==================");
    var ps = "問題:\n" + problem + "\n\n手順:\n" + plan;
    var solution = now solver.solve(ps);
    print(solution);
    print("");

    print("================== 3) レビュアー (リモート @ " + reviewer_addr + ") ==================");
    var psol = "問題:\n" + problem + "\n\n解答案:\n" + solution;
    var critique = remote_now(reviewer_addr, "reviewer", "review", psol);
    print(critique);
    print("");

    print("================== 使用量 (ホスト側 Planner + Solver のみ) ==================");
    print(ai_usage());
  }
}

var c = new Coordinator();
send c.tackle("次の Python 関数のバグを見つけて修正してください:\n\ndef factorial(n):\n    if n == 0:\n        return 1\n    return n + factorial(n - 1)\n\n回答には (a) バグの説明 と (b) コードブロックで修正後の関数 を含めてください。");
