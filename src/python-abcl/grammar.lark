// Lark grammar for ABCL/c+ (medium-scope Python implementation).
// Mirrors src/parser.mly: classes with var/float fields and methods,
// actor-style send/become, and the usual control-flow constructs.

start: decl+

?decl: class_decl
     | global_stmt

class_decl: "class" NAME "{" field* method_decl* "}"

field: ("var" | "float" | "int") NAME "=" expr ";"

method_decl: "method" NAME "(" params ")" "{" stmt* "}"
params: (NAME ("," NAME)*)?

global_stmt: var_new_stmt
           | var_decl_stmt
           | send_stmt
           | call_stmt

?stmt: var_new_stmt
     | var_decl_stmt
     | assign_stmt
     | send_stmt
     | call_stmt
     | if_stmt
     | while_stmt
     | become_stmt
     | block

var_new_stmt: ("var" | "float" | "int")? NAME "=" "new" NAME "(" args ")" ";"
var_decl_stmt: ("var" | "float" | "int") NAME "=" expr ";"
assign_stmt: NAME "=" expr ";"
send_stmt: "send" "self"   "." NAME "(" args ")" ";"   -> send_self
         | "send" "sender" "." NAME "(" args ")" ";"   -> send_sender
         | "send" NAME     "." NAME "(" args ")" ";"   -> send_named
call_stmt: ("call")? NAME "(" args ")" ";"
if_stmt: "if" "(" expr ")" stmt ("else" stmt)?
while_stmt: "while" expr "do" stmt
become_stmt: "become" NAME "(" args ")" ";"
block: "{" stmt* "}"

args: (expr ("," expr)*)?

?expr: rel_expr
?rel_expr: add_expr (rel_op add_expr)*
!rel_op: "==" | "!=" | "<=" | ">=" | "<" | ">"
?add_expr: mul_expr (add_op mul_expr)*
!add_op: "+" | "-"
?mul_expr: unary (mul_op unary)*
!mul_op: "*" | "/"
?unary: "-" unary    -> neg
      | atom

?atom: INT           -> int_lit
     | FLOAT         -> float_lit
     | STRING        -> string_lit
     | "self"        -> self_var
     | "sender"      -> sender_var
     | "new" NAME "(" args ")"   -> new_expr
     | NAME "(" args ")"         -> call_expr
     | NAME                      -> var_expr
     | "(" expr ")"

NAME: /(?!(class|method|var|float|int|new|send|call|become|if|else|while|do|self|sender|true|false)\b)[a-zA-Z_][a-zA-Z0-9_]*/
INT: /[0-9]+(?!\.)/
FLOAT: /[0-9]+\.[0-9]*|\.[0-9]+/
STRING: /"([^"\\]|\\.)*"/

%import common.WS
%ignore WS

COMMENT: "//" /[^\n]*/
%ignore COMMENT
