// Rotate4LinesPy.abcl
// Python (tkinter) 上で 4 本の線分を回転。中心は正方形の 4 頂点。
// Start / Stop ボタン付き。

class Spinner {
  var idx     = 0;
  var angle   = 0.;
  var speed   = 0.05;
  var cx      = 0.;
  var cy      = 0.;
  var radius  = 60.;
  var running = 1;
  var rr = 200; var gg = 220; var bb = 255;

  method init(i, sp, mx, my, r, g, b) {
    idx = i;
    speed = sp;
    cx = mx; cy = my;
    rr = r; gg = g; bb = b;
    running = 1;
    send self.tick();
  }

  method start() { running = 1; }
  method stop()  { running = 0; }

  method tick() {
    if (running == 1) {
      angle = angle + speed;
    }
    var c = cos(angle);
    var s = sin(angle);
    var dx = c * radius;
    var dy = s * radius;
    var x1 = cx + dx;
    var y1 = cy + dy;
    var x2 = cx - dx;
    var y2 = cy - dy;
    gui_set_line(idx, x1, y1, x2, y2, rr, gg, bb);
  }
}

class Controller {
  var s1 = 0; var s2 = 0; var s3 = 0; var s4 = 0;

  method init() {
    // 中心が正方形の 4 頂点になる配置 (640x500, 中央)
    s1 = new Spinner(0, 0.030, 200., 160., 255, 100, 100);
    s2 = new Spinner(1, 0.055, 440., 160., 100, 220, 130);
    s3 = new Spinner(2, 0.080, 200., 320., 100, 150, 255);
    s4 = new Spinner(3, 0.110, 440., 320., 240, 200, 100);

    gui_register_ticker(s1);
    gui_register_ticker(s2);
    gui_register_ticker(s3);
    gui_register_ticker(s4);

    gui_add_button("Start",  90, 440, 140, 36, self, "start");
    gui_add_button("Stop",  410, 440, 140, 36, self, "stop");
  }

  method start() {
    send s1.start();
    send s2.start();
    send s3.start();
    send s4.start();
  }

  method stop() {
    send s1.stop();
    send s2.stop();
    send s3.stop();
    send s4.stop();
  }
}

gui_open(640, 500, 0);
var ctrl = new Controller();
gui_run();
