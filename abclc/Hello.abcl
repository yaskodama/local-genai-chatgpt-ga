// OCaml AIPL sample.  The OCaml runtime predates the Phase 11-16
// surface (typed annotations, effects, pub, linear, transient cast)
// so the *syntax* below is intentionally untyped; for the typed
// equivalent see src/python-aipl/samples/Hello.abcl, which carries
// the modern contract:
//
//   class Hello {
//     var count: int = 0;
//     method init(n: int) { ... }
//   }
class Hello {
  float count = 0.;

  method init(n) {
    count = n;
    print("Hello object initialized with " + n);
  }

  method greet() {
    print("Hello! count = " + count);
  }

  method inc() {
    count = count + 1.;
    print("count incremented to " + count);
  }
}

var h = new Hello(5);      // ← 生成時に init(5) が自動呼び出しされる
send h.greet();            // Hello! count = 5
send h.inc();              // count incremented to 6
send h.greet();            // Hello! count = 6
