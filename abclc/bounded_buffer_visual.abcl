// ============================================================================
// Bounded Buffer (OCaml / SDL visualization) — capacity 20, interactive
// ============================================================================
//
// Capacity = 20 producer/consumer buffer, with speed bars (sliders) and big
// 7-segment digits for the "remaining input / remaining output" counts.
//
// Architecture note: the ABCL message-passing layer stringifies arrays when
// they cross actor boundaries, so the buffer actor and the renderer actor
// can't share the slots array via messages.  The simplest fix is to make the
// Buffer actor itself do the rendering — its own tick() method clears, draws,
// and presents every ~50 ms.  Producer / Consumer stay as separate actors
// and just receive `set_speed` messages when the user adjusts a speed.
//
// Layout (720 x 320):
//     Producer box : (10-70,  30-90)
//     Consumer box : (650-710, 30-90)
//     20 slots     : (141-579, 40-80), each 20 wide + 2 gap, 40 tall
//     Speed bars   : producer (10-350, 115-135), consumer (370-710, 115-135)
//     Big digits   : producer-side (14/30, 160) ; consumer-side (654/670, 160)
//
// Keyboard (SDL window must be focused):
//     UP  / DOWN  : producer faster / slower  (scancode 82 / 81)
//     LEFT/ RIGHT : consumer faster / slower  (scancode 80 / 79)
// Mouse:
//     Left-button drag over a speed bar sets that speed directly
//     (longer fill = faster).

class Buffer {
  var cap   = 20;
  var slots = array_empty();    // 20 int slots, filled in init
  var head  = 0;
  var tail  = 0;
  var count = 0;

  var pwaiter = "";
  var pitem   = 0;
  var cwaiter = "";

  // Rendering-side state (mirrored here because we merged Buffer + Renderer)
  var prodBlocked = 0;
  var consBlocked = 0;
  var prodSpeed   = 500;
  var consSpeed   = 800;

  // Defaults match the global actor names below so that
  // `send prod.set_speed(...)` routes correctly via the name-fallback.
  var prod = "prod";
  var cons = "cons";

  // Scratch int — assigning a param to this forces `param : int` during
  // type inference (see notes in the older 4-slot version).
  var _i = 0;

  method init() {
    cap = 20;
    var i = 0;
    while (i < 20) do {
      slots = array_push(slots, 0);
      i = i + 1;
    }
    send self.tick();
  }

  // ---- classic bounded-buffer methods ------------------------------------
  method put(item) {
    if (cwaiter != "") {
      send sender.put_ok();
      send cwaiter.got(item);
      cwaiter = "";
      consBlocked = 0;
    } else {
      if (count == cap) {
        pwaiter = sender;
        pitem   = item;
        prodBlocked = 1;
      } else {
        slots = array_set(slots, tail, item);
        tail = tail + 1;
        if (tail == cap) { tail = 0; }
        count = count + 1;
        send sender.put_ok();
      }
    }
  }

  method get() {
    if (count == 0) {
      cwaiter = sender;
      consBlocked = 1;
    } else {
      send sender.got(array_get(slots, head));
      head = head + 1;
      if (head == cap) { head = 0; }
      count = count - 1;
      if (pwaiter != "") {
        slots = array_set(slots, tail, pitem);
        tail = tail + 1;
        if (tail == cap) { tail = 0; }
        count = count + 1;
        send pwaiter.put_ok();
        prodBlocked = 0;
        pwaiter = "";
      }
    }
  }

  // ---- render tick: poll input, redraw, reschedule -----------------------
  method tick() {
    var k = sdl_poll_key();

    if (k == 82) {  // UP : producer faster
      prodSpeed = prodSpeed - 40;
      if (prodSpeed < 80) { prodSpeed = 80; }
      send prod.set_speed(prodSpeed);
    }
    if (k == 81) {  // DOWN : producer slower
      prodSpeed = prodSpeed + 40;
      if (prodSpeed > 2000) { prodSpeed = 2000; }
      send prod.set_speed(prodSpeed);
    }
    if (k == 80) {  // LEFT : consumer faster
      consSpeed = consSpeed - 40;
      if (consSpeed < 80) { consSpeed = 80; }
      send cons.set_speed(consSpeed);
    }
    if (k == 79) {  // RIGHT : consumer slower
      consSpeed = consSpeed + 40;
      if (consSpeed > 2000) { consSpeed = 2000; }
      send cons.set_speed(consSpeed);
    }

    // Mouse drag on speed bars (y ∈ [105, 145])
    var md = sdl_mouse_down();
    if (md == 1) {
      var mx = sdl_mouse_x();
      var my = sdl_mouse_y();
      if (my >= 105) {
        if (my <= 145) {
          // producer bar: x ∈ [10, 350], inner width 336
          if (mx >= 10) {
            if (mx <= 350) {
              var dx1 = mx - 12;
              if (dx1 < 0)   { dx1 = 0; }
              if (dx1 > 336) { dx1 = 336; }
              var ns1 = dx1 * 1920;
              ns1 = ns1 / 336;
              ns1 = 2000 - ns1;
              if (ns1 < 80)   { ns1 = 80; }
              if (ns1 > 2000) { ns1 = 2000; }
              prodSpeed = ns1;
              send prod.set_speed(prodSpeed);
            }
          }
          // consumer bar: x ∈ [370, 710], inner width 336
          if (mx >= 370) {
            if (mx <= 710) {
              var dx2 = mx - 372;
              if (dx2 < 0)   { dx2 = 0; }
              if (dx2 > 336) { dx2 = 336; }
              var ns2 = dx2 * 1920;
              ns2 = ns2 / 336;
              ns2 = 2000 - ns2;
              if (ns2 < 80)   { ns2 = 80; }
              if (ns2 > 2000) { ns2 = 2000; }
              consSpeed = ns2;
              send cons.set_speed(consSpeed);
            }
          }
        }
      }
    }

    call sdl_clear();
    call draw_all();
    call sdl_present();

    call wait(50);
    send self.tick();
  }

  method draw_all() {
    // ---- producer box (10,30)-(70,90) ------------------------------------
    var pr = 102; var pg = 204; var pb = 255;
    if (prodBlocked == 1) { pr = 255; pg = 153; pb = 85; }
    call sdl_line_c(10, 30,  70, 30,  pr, pg, pb);
    call sdl_line_c(70, 30,  70, 90,  pr, pg, pb);
    call sdl_line_c(70, 90,  10, 90,  pr, pg, pb);
    call sdl_line_c(10, 90,  10, 30,  pr, pg, pb);
    call sdl_line_c(16, 36,  64, 36,  pr, pg, pb);
    call sdl_line_c(64, 36,  64, 84,  pr, pg, pb);
    call sdl_line_c(64, 84,  16, 84,  pr, pg, pb);
    call sdl_line_c(16, 84,  16, 36,  pr, pg, pb);
    // arrow inside pointing right
    call sdl_line_c(25, 60,  55, 60,  pr, pg, pb);
    call sdl_line_c(50, 55,  55, 60,  pr, pg, pb);
    call sdl_line_c(50, 65,  55, 60,  pr, pg, pb);

    // ---- consumer box (650,30)-(710,90) ----------------------------------
    var cr = 255; var cg = 204; var cb = 102;
    if (consBlocked == 1) { cr = 255; cg = 153; cb = 85; }
    call sdl_line_c(650, 30,  710, 30,  cr, cg, cb);
    call sdl_line_c(710, 30,  710, 90,  cr, cg, cb);
    call sdl_line_c(710, 90,  650, 90,  cr, cg, cb);
    call sdl_line_c(650, 90,  650, 30,  cr, cg, cb);
    call sdl_line_c(656, 36,  704, 36,  cr, cg, cb);
    call sdl_line_c(704, 36,  704, 84,  cr, cg, cb);
    call sdl_line_c(704, 84,  656, 84,  cr, cg, cb);
    call sdl_line_c(656, 84,  656, 36,  cr, cg, cb);
    call sdl_line_c(665, 60,  695, 60,  cr, cg, cb);
    call sdl_line_c(690, 55,  695, 60,  cr, cg, cb);
    call sdl_line_c(690, 65,  695, 60,  cr, cg, cb);

    // ---- arrows producer→buffer and buffer→consumer ----------------------
    call sdl_line_c(70,  60, 140, 60, 136, 136, 170);
    call sdl_line_c(135, 55, 140, 60, 136, 136, 170);
    call sdl_line_c(135, 65, 140, 60, 136, 136, 170);
    call sdl_line_c(580, 60, 650, 60, 136, 136, 170);
    call sdl_line_c(645, 55, 650, 60, 136, 136, 170);
    call sdl_line_c(645, 65, 650, 60, 136, 136, 170);

    // ---- 20 buffer slots (x = 141 + i*22, y = 40..80) --------------------
    var i = 0;
    while (i < 20) do {
      var x0i = 141 + i * 22;
      var vi  = array_get(slots, i);
      call draw_slot(i, vi, x0i);
      i = i + 1;
    }

    // ---- speed bars ------------------------------------------------------
    call draw_bar(10,  115, 350, 135, prodSpeed, 102, 204, 255);
    call draw_bar(370, 115, 710, 135, consSpeed, 255, 204, 102);

    // ---- big digits: 残り入力可能 = cap - count --------------------------
    var remIn = cap - count;
    var icr = 153; var icg = 255; var icb = 238;
    if (remIn == 0) { icr = 255; icg = 153; icb = 85; }
    var d1i = remIn / 10;
    var d0i = remIn - d1i * 10;
    call draw_digit(d1i, 14, 160, icr, icg, icb);
    call draw_digit(d0i, 34, 160, icr, icg, icb);

    // ---- big digits: 残り出力可能 = count --------------------------------
    var remOut = count;
    var ocr = 255; var ocg = 238; var ocb = 153;
    if (remOut == 0) { ocr = 255; ocg = 153; ocb = 85; }
    var d1o = remOut / 10;
    var d0o = remOut - d1o * 10;
    call draw_digit(d1o, 654, 160, ocr, ocg, ocb);
    call draw_digit(d0o, 674, 160, ocr, ocg, ocb);

    // ---- keyboard-hint crosses (↑↓ under producer digits, ←→ under cons)
    // producer: up/down cross at (30, 220)
    call sdl_line_c(30, 210,  30, 232, 102, 204, 255);
    call sdl_line_c(26, 214,  30, 210, 102, 204, 255);
    call sdl_line_c(34, 214,  30, 210, 102, 204, 255);
    call sdl_line_c(26, 228,  30, 232, 102, 204, 255);
    call sdl_line_c(34, 228,  30, 232, 102, 204, 255);
    // consumer: left/right cross at (670, 220)
    call sdl_line_c(660, 220, 682, 220, 255, 204, 102);
    call sdl_line_c(664, 216, 660, 220, 255, 204, 102);
    call sdl_line_c(664, 224, 660, 220, 255, 204, 102);
    call sdl_line_c(678, 216, 682, 220, 255, 204, 102);
    call sdl_line_c(678, 224, 682, 220, 255, 204, 102);
  }

  // Draw one buffer slot: grey border always, green inner frame if filled.
  method draw_slot(idx, val, x0) {
    _i = idx; _i = val; _i = x0;
    call sdl_line_c(x0,      40, x0 + 20, 40, 136, 136, 170);
    call sdl_line_c(x0 + 20, 40, x0 + 20, 80, 136, 136, 170);
    call sdl_line_c(x0 + 20, 80, x0,      80, 136, 136, 170);
    call sdl_line_c(x0,      80, x0,      40, 136, 136, 170);
    // (idx - head + cap) % cap < count  ⇒  this slot is currently filled
    var diff = idx - head;
    if (diff < 0) { diff = diff + cap; }
    if (diff < count) {
      call sdl_line_c(x0 + 2,  42, x0 + 18, 42, 85, 255, 85);
      call sdl_line_c(x0 + 18, 42, x0 + 18, 78, 85, 255, 85);
      call sdl_line_c(x0 + 18, 78, x0 + 2,  78, 85, 255, 85);
      call sdl_line_c(x0 + 2,  78, x0 + 2,  42, 85, 255, 85);
      // a couple of horizontal "fill" lines so a filled slot reads clearly
      call sdl_line_c(x0 + 4,  54, x0 + 16, 54, 140, 255, 140);
      call sdl_line_c(x0 + 4,  60, x0 + 16, 60, 140, 255, 140);
      call sdl_line_c(x0 + 4,  66, x0 + 16, 66, 140, 255, 140);
    }
  }

  // Horizontal speed bar.  Fill length ∝ (2000 - speed), so a long fill = fast.
  method draw_bar(x1, y1, x2, y2, speed, r, g, b) {
    _i = x1; _i = y1; _i = x2; _i = y2; _i = speed;
    call sdl_line_c(x1, y1, x2, y1, 136, 136, 170);
    call sdl_line_c(x2, y1, x2, y2, 136, 136, 170);
    call sdl_line_c(x2, y2, x1, y2, 136, 136, 170);
    call sdl_line_c(x1, y2, x1, y1, 136, 136, 170);
    var w = x2 - x1 - 4;
    var fill = 2000 - speed;
    fill = fill * w;
    fill = fill / 1920;
    if (fill < 2) { fill = 2; }
    var y = y1 + 2;
    while (y <= y2 - 2) do {
      call sdl_line_c(x1 + 2, y, x1 + 2 + fill, y, r, g, b);
      y = y + 1;
    }
  }

  // 7-segment digit, 14 wide × 24 tall.
  method draw_digit(d, x, y, r, g, b) {
    _i = d; _i = x; _i = y;
    if (d == 0) {
      call sdl_line_c(x,      y,      x + 14, y,      r, g, b);
      call sdl_line_c(x + 14, y,      x + 14, y + 12, r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 24, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 12, x,      y + 24, r, g, b);
      call sdl_line_c(x,      y,      x,      y + 12, r, g, b);
    }
    if (d == 1) {
      call sdl_line_c(x + 14, y,      x + 14, y + 12, r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
    }
    if (d == 2) {
      call sdl_line_c(x,      y,      x + 14, y,      r, g, b);
      call sdl_line_c(x + 14, y,      x + 14, y + 12, r, g, b);
      call sdl_line_c(x,      y + 24, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 12, x,      y + 24, r, g, b);
      call sdl_line_c(x,      y + 12, x + 14, y + 12, r, g, b);
    }
    if (d == 3) {
      call sdl_line_c(x,      y,      x + 14, y,      r, g, b);
      call sdl_line_c(x + 14, y,      x + 14, y + 12, r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 24, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 12, x + 14, y + 12, r, g, b);
    }
    if (d == 4) {
      call sdl_line_c(x + 14, y,      x + 14, y + 12, r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y,      x,      y + 12, r, g, b);
      call sdl_line_c(x,      y + 12, x + 14, y + 12, r, g, b);
    }
    if (d == 5) {
      call sdl_line_c(x,      y,      x + 14, y,      r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 24, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y,      x,      y + 12, r, g, b);
      call sdl_line_c(x,      y + 12, x + 14, y + 12, r, g, b);
    }
    if (d == 6) {
      call sdl_line_c(x,      y,      x + 14, y,      r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 24, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 12, x,      y + 24, r, g, b);
      call sdl_line_c(x,      y,      x,      y + 12, r, g, b);
      call sdl_line_c(x,      y + 12, x + 14, y + 12, r, g, b);
    }
    if (d == 7) {
      call sdl_line_c(x,      y,      x + 14, y,      r, g, b);
      call sdl_line_c(x + 14, y,      x + 14, y + 12, r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
    }
    if (d == 8) {
      call sdl_line_c(x,      y,      x + 14, y,      r, g, b);
      call sdl_line_c(x + 14, y,      x + 14, y + 12, r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 24, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 12, x,      y + 24, r, g, b);
      call sdl_line_c(x,      y,      x,      y + 12, r, g, b);
      call sdl_line_c(x,      y + 12, x + 14, y + 12, r, g, b);
    }
    if (d == 9) {
      call sdl_line_c(x,      y,      x + 14, y,      r, g, b);
      call sdl_line_c(x + 14, y,      x + 14, y + 12, r, g, b);
      call sdl_line_c(x + 14, y + 12, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y + 24, x + 14, y + 24, r, g, b);
      call sdl_line_c(x,      y,      x,      y + 12, r, g, b);
      call sdl_line_c(x,      y + 12, x + 14, y + 12, r, g, b);
    }
  }
}

class Producer {
  var buf   = "";
  var n     = 0;
  var speed = 500;

  method init(b) {
    buf = b;
    send self.produce();
  }

  method produce() {
    n = n + 1;
    send buf.put(n);
  }

  method put_ok() {
    call wait(speed);
    send self.produce();
  }

  method set_speed(s) { speed = s; }
}

class Consumer {
  var buf   = "";
  var taken = 0;
  var speed = 800;

  method init(b) {
    buf = b;
    send buf.get();
  }

  method got(item) {
    taken = taken + 1;
    call wait(speed);
    send self.do_get();
  }

  method do_get() { send buf.get(); }

  method set_speed(s) { speed = s; }
}

sdl_init(720, 260);

// Global names must match the default string fields inside Buffer (`prod`,
// `cons`) so that Buffer's set_speed sends route to them via the fallback.
var buf  = new Buffer();
var prod = new Producer(buf);
var cons = new Consumer(buf);
