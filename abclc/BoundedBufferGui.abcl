// BoundedBufferGui.abcl
// 有限バッファ (producer-consumer) 可視化。
// 「入力速度バー (track 0)」「出力速度バー (track 1)」をマウスでドラッグして
// それぞれの producer / consumer の生成・消費レートを変える。

class Buffer {
  var capacity = 5;
  var count    = 0;

  method init(cap) {
    capacity = cap;
    count    = 0;
  }

  method put(producerId) {
    if (count < capacity) {
      count = count + 1;
      gui_buf_put(producerId);
      send sender.put_ok();
    } else {
      send sender.put_full();
    }
  }

  method take(consumerId) {
    if (count > 0) {
      count = count - 1;
      gui_buf_take(consumerId);
      send sender.take_ok();
    } else {
      send sender.take_empty();
    }
  }
}

// Producer: idle → working → waiting (put 要求中)
//   idle 待機の長さを track 0 のスライダー値で制御
class Producer {
  var idx     = 0;
  var state   = 0;
  var counter = 0;
  var buffer  = 0;
  var running = 0;

  method init(i, buf) {
    idx     = i;
    buffer  = buf;
    state   = 0;
    counter = 30 + i * 12;
    running = 0;
    gui_set_actor(idx, 0, 0);
  }

  method start() { running = 1; }
  method stop()  { running = 0; }

  method tick() {
    if (running == 1) {
      if (state == 0) {
        counter = counter - 1;
        if (counter < 1) {
          state = 1;
          counter = 18;
          gui_set_actor(idx, 0, 1);
        }
      } else {
        if (state == 1) {
          counter = counter - 1;
          if (counter < 1) {
            state = 2;
            gui_set_actor(idx, 0, 2);
            send buffer.put(idx);
          }
        }
      }
    }
  }

  method put_ok() {
    if (state == 2) {
      state = 0;
      // 速度バー値 1..10 → idle counter 100..10
      counter = 110 - gui_slider_value(0) * 10;
      gui_set_actor(idx, 0, 0);
    }
  }

  method put_full() {
    if (state == 2) {
      state = 1;
      counter = 8;
    }
  }
}

// Consumer: idle → take 要求中 → 消費中
//   idle 待機の長さを track 1 のスライダー値で制御
class Consumer {
  var idx     = 0;
  var state   = 0;
  var counter = 0;
  var buffer  = 0;
  var running = 0;

  method init(i, buf) {
    idx     = i;
    buffer  = buf;
    state   = 0;
    counter = 50 + i * 10;
    running = 0;
    gui_set_actor(idx, 1, 0);
  }

  method start() { running = 1; }
  method stop()  { running = 0; }

  method tick() {
    if (running == 1) {
      if (state == 0) {
        counter = counter - 1;
        if (counter < 1) {
          state = 2;
          gui_set_actor(idx, 1, 2);
          send buffer.take(idx);
        }
      } else {
        if (state == 1) {
          counter = counter - 1;
          if (counter < 1) {
            state = 0;
            counter = 110 - gui_slider_value(1) * 10;
            gui_set_actor(idx, 1, 0);
          }
        }
      }
    }
  }

  method take_ok() {
    if (state == 2) {
      state = 1;
      counter = 18;
      gui_set_actor(idx, 1, 1);
    }
  }

  method take_empty() {
    if (state == 2) {
      state = 0;
      counter = 8;
    }
  }
}

class Controller {
  var buf = 0;
  var p0 = 0; var p1 = 0; var p2 = 0;
  var c0 = 0; var c1 = 0; var c2 = 0;

  method init() {
    buf = new Buffer(20);

    p0 = new Producer(0, buf);
    p1 = new Producer(1, buf);
    p2 = new Producer(2, buf);

    c0 = new Consumer(0, buf);
    c1 = new Consumer(1, buf);
    c2 = new Consumer(2, buf);

    // 4 番目の引数 = 下端の予約高さ (スライダ＋ボタン用)
    gui_buf_setup(20, 3, 3, 200);

    gui_register_ticker(p0);
    gui_register_ticker(p1);
    gui_register_ticker(p2);
    gui_register_ticker(c0);
    gui_register_ticker(c1);
    gui_register_ticker(c2);

    // 入力速度バー (track 0): 赤系、ラベル "IN"
    gui_add_slider(0, 120, 460, 520, 16, 1, 10, 5, 220,  90,  90, "IN");
    // 出力速度バー (track 1): 緑系、ラベル "OUT"
    gui_add_slider(1, 120, 500, 520, 16, 1, 10, 5,  90, 200, 130, "OUT");

    gui_add_button("Start", 220, 560, 120, 40, self, "start");
    gui_add_button("Stop",  420, 560, 120, 40, self, "stop");
  }

  method start() {
    send p0.start();
    send p1.start();
    send p2.start();
    send c0.start();
    send c1.start();
    send c2.start();
  }

  method stop() {
    send p0.stop();
    send p1.stop();
    send p2.stop();
    send c0.stop();
    send c1.stop();
    send c2.stop();
  }
}

gui_open(760, 620, 0);
var ctrl = new Controller();
gui_run();
