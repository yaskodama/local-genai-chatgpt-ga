// OCaml AIPL sample.  The Phase 11+ typed equivalent lives at
// src/python-aipl/samples/Counter.abcl, which annotates the field
// and method bodies (`var count: int = 0;`).  Output is identical.
class Counter {
  var count = 0.;
  method inc() {
    count = count + 1.;
    print("count:"+count);
    send self.dec(3.);
  }
  method dec(x) {
    count = count - x;
    print(count);
  }
}

var c1 = new Counter();
var c2 = new Counter();
send c1.inc();
send c2.inc();
