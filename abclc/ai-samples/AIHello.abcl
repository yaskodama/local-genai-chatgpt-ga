// First AI sample on the OCaml ABCL/c+ runtime.
// Requires GEMINI_API_KEY in the environment when launching the REPL.
class Greeter {
  method ask(question) {
    var resp = ai_call(question);
    print("Q: " + question);
    print("A:");
    print(resp);
  }
}

var g = new Greeter();
send g.ask("Say hello in exactly THREE different languages: English, Japanese, and French.  Output one greeting per line, each on its own line, with the language name in parentheses afterward.  No preamble, no commentary.  Example format:\nHello (English)\nこんにちは (Japanese)\nBonjour (French)");
